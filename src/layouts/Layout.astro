---
import { films } from '../data/films';

interface Props {
  title: string;
  description?: string;
  activeSlug?: string;
  activeNav?: 'films' | 'about' | 'cv';
}

const { 
  title, 
  description = "Cầm Đức Hiệp - Filmmaker Portfolio", 
  activeSlug,
  activeNav = 'films'
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Cầm Đức Hiệp</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} | Cầm Đức Hiệp`} />
    <meta property="og:description" content={description} />
    
    <!-- Google Fonts: Inter & Fraunces -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;1,9..144,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style is:global>
      :root {
        --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
        --font-serif: 'Fraunces', Georgia, serif;
        --color-bg: #ffffff;
        --color-text: #313030;
        --color-muted: #545454;
      }
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      html, body {
        background-color: #ffffff;
        color: #313030;
        font-family: var(--font-sans);
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        line-height: 1.4;
      }
      a {
        color: #313030;
        text-decoration: none !important;
      }
      /* Clean minimal scrollbar */
      ::-webkit-scrollbar {
        width: 6px;
        height: 6px;
      }
      ::-webkit-scrollbar-track {
        background: #ffffff;
      }
      ::-webkit-scrollbar-thumb {
        background: #e0e0e0;
        border-radius: 3px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #bbbbbb;
      }
    </style>
  </head>
  <body>
    <div style="display: flex; min-height: 100vh; width: 100%; background: #ffffff;">
      <!-- Left Sidebar (No border, clean spacing) -->
      <aside style="width: 280px; flex-shrink: 0; padding: 75px 40px 75px 70px; position: sticky; top: 0; height: 100vh; overflow-y: auto; display: flex; flex-direction: column; background: #ffffff;">
        <nav style="display: flex; flex-direction: column;">
          <!-- Films Section Header -->
          <div style="margin-bottom: 0.65rem;">
            <a 
              href="/" 
              style={`font-size: 1rem; font-weight: 600; letter-spacing: -0.01em; text-decoration: none !important; transition: color 0.15s ease, opacity 0.2s; ${
                currentPath === '/' 
                  ? 'color: #545454; font-weight: 400;' 
                  : 'color: #313030; font-weight: 600;'
              }`}
            >
              Films
            </a>
          </div>

          <!-- Film Submenu -->
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.5rem; padding-left: 0; margin-bottom: 2.25rem;">
            {films.map((film) => {
              const isActive = currentPath === `/films/${film.slug}`;
              return (
                <li>
                  <a 
                    href={`/films/${film.slug}`} 
                    style={`font-size: 0.92rem; text-decoration: none !important; transition: color 0.15s ease, opacity 0.15s ease; display: block; ${
                      isActive 
                        ? 'color: #545454; font-weight: 400;' 
                        : 'color: #313030; font-weight: 500;'
                    }`}
                    onmouseover="this.style.color='#545454';"
                    onmouseout={isActive ? "this.style.color='#545454';" : "this.style.color='#313030';"}
                  >
                    {film.title}
                  </a>
                </li>
              );
            })}
          </ul>

          <!-- About & CV Links -->
          <div style="display: flex; flex-direction: column; gap: 0.65rem;">
            <a 
              href="/about" 
              style={`font-size: 1rem; font-weight: 600; letter-spacing: -0.01em; text-decoration: none !important; transition: color 0.15s ease; ${
                currentPath === '/about' 
                  ? 'color: #545454; font-weight: 400;' 
                  : 'color: #313030; font-weight: 600;'
              }`}
              onmouseover="this.style.color='#545454';"
              onmouseout={currentPath === '/about' ? "this.style.color='#545454';" : "this.style.color='#313030';"}
            >
              About
            </a>

            <a 
              href="/cv" 
              style={`font-size: 1rem; font-weight: 600; letter-spacing: -0.01em; text-decoration: none !important; transition: color 0.15s ease; ${
                currentPath === '/cv' 
                  ? 'color: #545454; font-weight: 400;' 
                  : 'color: #313030; font-weight: 600;'
              }`}
              onmouseover="this.style.color='#545454';"
              onmouseout={currentPath === '/cv' ? "this.style.color='#545454';" : "this.style.color='#313030';"}
            >
              CV
            </a>
          </div>
        </nav>
      </aside>

      <!-- Main Content Area -->
      <main style="flex: 1; min-width: 0; padding: 75px 60px 100px 30px; background: #ffffff;">
        <slot />
      </main>
    </div>
  </body>
</html>
