---
import { films } from '../data/films';

interface Props {
  title: string;
  description?: string;
  activeSlug?: string;
  activeNav?: 'films' | 'about' | 'cv';
}

const { 
  title, 
  description = "Cầm Đức Hiệp - Filmmaker Portfolio", 
  activeSlug,
  activeNav = 'films'
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Cầm Đức Hiệp</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} | Cầm Đức Hiệp`} />
    <meta property="og:description" content={description} />
    
    <!-- Google Fonts: Inter & Fraunces -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;1,9..144,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style is:global>
      :root {
        --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
        --font-serif: 'Fraunces', Georgia, serif;
      }
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      html, body {
        background-color: #ffffff !important;
        color: #000000 !important;
        font-family: var(--font-sans);
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        line-height: 1.6;
      }
      /* Triệt để bỏ gạch chân cho toàn bộ link */
      a, a:hover, a:focus, a:visited {
        color: #000000;
        text-decoration: none !important;
      }
      /* Scrollbar */
      ::-webkit-scrollbar {
        width: 6px;
        height: 6px;
      }
      ::-webkit-scrollbar-track {
        background: #ffffff;
      }
      ::-webkit-scrollbar-thumb {
        background: #e0e0e0;
        border-radius: 3px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #bbbbbb;
      }

      .site-layout {
        display: flex;
        flex-direction: row;
        min-height: 100vh;
        width: 100%;
        background-color: #ffffff;
      }

      .site-sidebar {
        width: 250px;
        flex-shrink: 0;
        padding: 75px 30px 75px 70px;
        position: sticky;
        top: 0;
        height: 100vh;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        background-color: #ffffff;
      }

      .site-main {
        flex: 1;
        min-width: 0;
        padding: 75px 60px 100px 30px;
        background-color: #ffffff;
      }

      /* Quy tắc UX: Chưa chọn thì ĐEN RÕ, Khi được chọn thì MỜ ĐI */
      .nav-heading {
        font-size: 1rem;
        font-weight: 600;
        color: #000000 !important;
        letter-spacing: -0.01em;
        text-decoration: none !important;
        display: block;
        transition: opacity 0.2s ease;
        opacity: 1; /* Bình thường đen rõ */
      }
      .nav-heading.is-active {
        opacity: 0.35 !important; /* Khi chọn: mờ đi */
      }
      .nav-heading:hover {
        opacity: 0.65;
      }

      .film-nav-list {
        list-style: none !important;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding-left: 0 !important;
        margin: 0.65rem 0 2.25rem 0 !important;
      }

      .film-nav-item {
        font-size: 0.92rem;
        font-weight: 400;
        color: #000000 !important;
        text-decoration: none !important;
        display: block;
        transition: opacity 0.2s ease;
        opacity: 1; /* Bình thường đen rõ */
      }
      .film-nav-item.is-active {
        opacity: 0.35 !important; /* Khi chọn: mờ đi */
      }
      .film-nav-item:hover {
        opacity: 0.65;
      }

      /* Chỉ gập layout sang 1 cột khi màn hình thực sự nhỏ (mobile < 680px) */
      @media (max-width: 680px) {
        .site-layout {
          flex-direction: column !important;
        }
        .site-sidebar {
          width: 100% !important;
          height: auto !important;
          position: static !important;
          padding: 30px 24px !important;
        }
        .site-main {
          padding: 24px 20px 60px !important;
        }
      }
    </style>
  </head>
  <body>
    <div class="site-layout">
      <!-- Cột trái: Sidebar Navigation -->
      <aside class="site-sidebar">
        <nav style="display: flex; flex-direction: column;">
          <!-- Mục Films -->
          <div>
            <a 
              href="/" 
              class={`nav-heading ${currentPath === '/' ? 'is-active' : ''}`}
            >
              Films
            </a>
          </div>

          <!-- Danh sách 5 phim -->
          <ul class="film-nav-list">
            {films.map((film) => {
              const isActive = currentPath === `/films/${film.slug}`;
              return (
                <li>
                  <a 
                    href={`/films/${film.slug}`} 
                    class={`film-nav-item ${isActive ? 'is-active' : ''}`}
                  >
                    {film.title}
                  </a>
                </li>
              );
            })}
          </ul>

          <!-- Mục About & CV -->
          <div style="display: flex; flex-direction: column; gap: 0.65rem;">
            <a 
              href="/about" 
              class={`nav-heading ${currentPath === '/about' ? 'is-active' : ''}`}
            >
              About
            </a>

            <a 
              href="/cv" 
              class={`nav-heading ${currentPath === '/cv' ? 'is-active' : ''}`}
            >
              CV
            </a>
          </div>
        </nav>

        <!-- Admin link -->
        <div style="padding-top: 2rem;">
          <a 
            href="/admin" 
            target="_blank" 
            style="font-size: 0.75rem; color: #000000; opacity: 0.2; text-decoration: none !important; transition: opacity 0.2s;"
            onmouseover="this.style.opacity='0.6';"
            onmouseout="this.style.opacity='0.2';"
          >
            ● Admin CMS
          </a>
        </div>
      </aside>

      <!-- Khung nội dung chính -->
      <main class="site-main">
        <slot />
      </main>
    </div>
  </body>
</html>
