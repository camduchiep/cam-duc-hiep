---
import { films } from '../data/films';

interface Props {
  title: string;
  description?: string;
  activeSlug?: string;
  activeNav?: 'films' | 'about' | 'cv';
}

const { 
  title, 
  description = "Cầm Đức Hiệp - Filmmaker Portfolio", 
  activeSlug,
  activeNav = 'films'
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Cầm Đức Hiệp</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} | Cầm Đức Hiệp`} />
    <meta property="og:description" content={description} />
    
    <!-- Google Fonts: Inter & Fraunces -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;1,9..144,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style is:global>
      :root {
        --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
        --font-serif: 'Fraunces', Georgia, serif;
        --color-bg: #ffffff;
        --color-text: #000000;
        --color-border: #f0f0f0;
      }
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      html, body {
        background-color: #ffffff;
        color: #000000;
        font-family: var(--font-sans);
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        line-height: 1.6;
      }
      a {
        color: #000000;
        text-decoration: none;
      }
      /* Clean minimal scrollbar */
      ::-webkit-scrollbar {
        width: 6px;
        height: 6px;
      }
      ::-webkit-scrollbar-track {
        background: #ffffff;
      }
      ::-webkit-scrollbar-thumb {
        background: #dddddd;
        border-radius: 3px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #999999;
      }
    </style>
  </head>
  <body>
    <div style="display: flex; min-height: 100vh; width: 100%; background: #ffffff;">
      <!-- Fixed Left Sidebar -->
      <aside style="width: 280px; flex-shrink: 0; padding: 70px 40px; position: sticky; top: 0; height: 100vh; overflow-y: auto; display: flex; flex-direction: column; justify-content: space-between; border-right: 1px solid var(--color-border); background: #ffffff;">
        <nav style="display: flex; flex-direction: column;">
          <!-- Films Section Header -->
          <div style="margin-bottom: 0.75rem;">
            <a 
              href="/" 
              style={`font-size: 1.05rem; font-weight: 600; color: #000000; letter-spacing: -0.01em; transition: opacity 0.2s; ${currentPath === '/' ? 'opacity: 1;' : 'opacity: 0.8;'}`}
            >
              Films
            </a>
          </div>

          <!-- Film Submenu -->
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.55rem; padding-left: 0; margin-bottom: 2.5rem;">
            {films.map((film) => {
              const isActive = currentPath === `/films/${film.slug}`;
              return (
                <li>
                  <a 
                    href={`/films/${film.slug}`} 
                    style={`font-size: 0.92rem; color: #000000; transition: opacity 0.2s ease; display: block; ${
                      isActive 
                        ? 'font-weight: 600; opacity: 1;' 
                        : 'font-weight: 400; opacity: 0.45;'
                    }`}
                    onmouseover="this.style.opacity='1';"
                    onmouseout={isActive ? "this.style.opacity='1';" : "this.style.opacity='0.45';"}
                  >
                    {film.title}
                  </a>
                </li>
              );
            })}
          </ul>

          <!-- About & CV Links -->
          <div style="display: flex; flex-direction: column; gap: 0.75rem;">
            <a 
              href="/about" 
              style={`font-size: 1.05rem; font-weight: 600; color: #000000; letter-spacing: -0.01em; transition: opacity 0.2s ease; ${
                currentPath === '/about' 
                  ? 'opacity: 1;' 
                  : 'opacity: 0.45;'
              }`}
              onmouseover="this.style.opacity='1';"
              onmouseout={currentPath === '/about' ? "this.style.opacity='1';" : "this.style.opacity='0.45';"}
            >
              About
            </a>

            <a 
              href="/cv" 
              style={`font-size: 1.05rem; font-weight: 600; color: #000000; letter-spacing: -0.01em; transition: opacity 0.2s ease; ${
                currentPath === '/cv' 
                  ? 'opacity: 1;' 
                  : 'opacity: 0.45;'
              }`}
              onmouseover="this.style.opacity='1';"
              onmouseout={currentPath === '/cv' ? "this.style.opacity='1';" : "this.style.opacity='0.45';"}
            >
              CV
            </a>
          </div>
        </nav>

        <!-- Admin entry point -->
        <div style="padding-top: 2rem;">
          <a 
            href="/admin" 
            target="_blank" 
            style="font-size: 0.75rem; color: #000000; opacity: 0.25; transition: opacity 0.2s; text-decoration: none;"
            onmouseover="this.style.opacity='0.7';"
            onmouseout="this.style.opacity='0.25';"
          >
            ● Admin CMS
          </a>
        </div>
      </aside>

      <!-- Main Content Area -->
      <main style="flex: 1; min-width: 0; padding: 70px 60px 100px 60px; max-width: 1400px; background: #ffffff;">
        <slot />
      </main>
    </div>

    <!-- Responsive Mobile Bar -->
    <style>
      @media (max-width: 860px) {
        div[style*="display: flex"] {
          flex-direction: column !important;
        }
        aside {
          width: 100% !important;
          height: auto !important;
          position: static !important;
          padding: 30px 24px !important;
          border-right: none !important;
          border-bottom: 1px solid var(--color-border) !important;
        }
        main {
          padding: 30px 24px 60px !important;
        }
      }
    </style>
  </body>
</html>
