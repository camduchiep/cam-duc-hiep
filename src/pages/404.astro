---
import Layout from '../layouts/Layout.astro';

export const prerender = false;
---

<Layout title="Không tìm thấy trang (404)">
  <div class="container" style="text-align: center; padding: 6rem 0;">
    <h1 style="font-size: 5rem; font-weight: 800; color: #cbd5e1; line-height: 1;">404</h1>
    <h2 style="font-size: 1.75rem; font-weight: 700; color: #0f172a; margin: 1rem 0;">Trang không tồn tại</h2>
    <p style="color: #64748b; font-size: 1.1rem; margin-bottom: 2rem;">
      Bài viết hoặc liên kết bạn đang tìm kiếm có thể đã bị xóa hoặc không còn tồn tại.
    </p>
    <a href="/" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; background: #0284c7; color: #fff; border-radius: 0.5rem; font-weight: 600; text-decoration: none;">
      Về trang chủ
    </a>
  </div>
</Layout>
