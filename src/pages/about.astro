---
import Layout from '../layouts/Layout.astro';
import { getAboutData } from '../lib/content';

export const prerender = false;

const db = Astro.locals.runtime?.env?.DB;
const about = await getAboutData(db);
---

<Layout title="About" activeNav="about">
  <div style="max-width: 800px; display: flex; flex-direction: column; gap: 48px; background: #ffffff;">
    <!-- Bio Text -->
    <div style="font-size: 1.05rem; line-height: 1.8; color: #000000; font-weight: 400; display: flex; flex-direction: column; gap: 16px;">
      {about.bioParagraphs && about.bioParagraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>

    <!-- Contact & Location Info -->
    <div style="display: flex; flex-direction: column; gap: 8px; font-size: 0.95rem; color: #000000; padding-top: 16px;">
      {about.location && (
        <div style="opacity: 0.7;">{about.location}</div>
      )}
      {about.email && (
        <div>
          <a 
            href={`mailto:${about.email}`} 
            style="color: #000000; text-decoration: underline; text-underline-offset: 4px; transition: opacity 0.2s;"
            onmouseover="this.style.opacity='0.6';"
            onmouseout="this.style.opacity='1';"
          >
            {about.email}
          </a>
        </div>
      )}
      {about.phone && (
        <div>
          <a 
            href={`tel:${about.phone.replace(/[^0-9+]/g, '')}`} 
            style="color: #000000; opacity: 0.7; text-decoration: none; transition: opacity 0.2s;"
            onmouseover="this.style.opacity='1';"
            onmouseout="this.style.opacity='0.7';"
          >
            {about.phone}
          </a>
        </div>
      )}
    </div>
  </div>
</Layout>
