---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { films } from '../../../../data/films';

export const prerender = false;

const { slug } = Astro.params;
const film = films.find((f) => f.slug === slug);

if (!film) {
  return Astro.redirect('/admin');
}
---

<AdminLayout title={`Sửa phim: ${film.title}`} activeTab="films">
  <!-- Top Navigation Bar -->
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <div>
      <a href="/admin" style="color: #64748b; font-size: 0.88rem; text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 500;">
        ← Quay lại danh mục Phim
      </a>
      <h1 style="font-size: 1.75rem; font-weight: 700; color: #0f172a; margin-top: 0.5rem; letter-spacing: -0.01em;">
        Chỉnh sửa phim: <span style="color: #0284c7;">{film.title}</span>
      </h1>
    </div>
    <div style="display: flex; gap: 0.75rem;">
      <a href={`/films/${film.slug}`} target="_blank" class="btn btn-outline">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        Xem trên web
      </a>
      <button type="button" onclick="alert('Đã lưu dữ liệu phim thành công!')" class="btn btn-primary">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
        Lưu thay đổi
      </button>
    </div>
  </div>

  <!-- Main Grid Form -->
  <div style="display: grid; grid-template-columns: 2.2fr 1fr; gap: 2rem; align-items: start;">
    <!-- Left Column: Core Data -->
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
      <!-- Title & Basic Info Card -->
      <div class="card">
        <h3 style="font-size: 1.1rem; font-weight: 700; color: #0f172a; margin-bottom: 1.25rem; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.5rem;">
          1. Thông tin tiêu đề & Định danh
        </h3>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
          <div>
            <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 0.4rem;">
              Tiêu đề phim (Title) <span style="color: #ef4444;">*</span>
            </label>
            <input 
              type="text" 
              value={film.title}
              style="width: 100%; padding: 0.65rem 0.85rem; border-radius: 0.375rem; border: 1px solid #cbd5e1; font-size: 0.95rem; font-weight: 600;"
            />
          </div>
          <div>
            <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 0.4rem;">
              Tiêu đề gốc / Tiếng Việt (Original Title)
            </label>
            <input 
              type="text" 
              value={film.originalTitle}
              style="width: 100%; padding: 0.65rem 0.85rem; border-radius: 0.375rem; border: 1px solid #cbd5e1; font-size: 0.95rem;"
            />
          </div>
        </div>

        <div style="margin-bottom: 1rem;">
          <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 0.4rem;">
            Tiêu đề hiển thị đầy đủ (Display Title)
          </label>
          <input 
            type="text" 
            value={film.displayTitle}
            style="width: 100%; padding: 0.65rem 0.85rem; border-radius: 0.375rem; border: 1px solid #cbd5e1; font-size: 0.95rem;"
          />
        </div>

        <div>
          <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 0.4rem;">
            Đường dẫn Slug (URL)
          </label>
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <span style="color: #64748b; font-size: 0.9rem; font-family: monospace;">/films/</span>
            <input 
              type="text" 
              value={film.slug}
              style="flex: 1; padding: 0.55rem 0.75rem; border-radius: 0.375rem; border: 1px solid #cbd5e1; font-size: 0.9rem; font-family: monospace; background: #f8fafc;"
              readonly
            />
          </div>
        </div>
      </div>

      <!-- Synopsis Card -->
      <div class="card">
        <h3 style="font-size: 1.1rem; font-weight: 700; color: #0f172a; margin-bottom: 1.25rem; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.5rem;">
          2. Tóm tắt nội dung phim (Synopsis)
        </h3>
        <textarea 
          rows="6" 
          style="width: 100%; padding: 0.85rem 1rem; border-radius: 0.5rem; border: 1px solid #cbd5e1; font-family: inherit; font-size: 0.95rem; line-height: 1.6; color: #0f172a;"
        >{film.synopsis}</textarea>
      </div>

      <!-- Stills Gallery Card -->
      <div class="card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.5rem;">
          <h3 style="font-size: 1.1rem; font-weight: 700; color: #0f172a; margin: 0;">
            3. Thư viện ảnh Stills ({film.stills?.length || 0} ảnh)
          </h3>
          <span style="font-size: 0.82rem; color: #64748b;">Ảnh xuất hiện xếp chồng theo chiều dọc tại trang phim</span>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 1rem;">
          {film.stills && film.stills.map((still, idx) => (
            <div style="border-radius: 0.5rem; overflow: hidden; border: 1px solid #e2e8f0; background: #f8fafc; position: relative;">
              <img 
                src={still} 
                alt={`Still ${idx + 1}`}
                style="width: 100%; height: 110px; object-fit: cover; display: block;" 
              />
              <div style="padding: 0.5rem; font-size: 0.78rem; color: #64748b; display: flex; justify-content: space-between; align-items: center;">
                <span>Still #{idx + 1}</span>
                <span style="font-family: monospace; font-size: 0.72rem; color: #94a3b8; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 110px;">
                  {still.split('/').pop()}
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Credits Card -->
      <div class="card">
        <h3 style="font-size: 1.1rem; font-weight: 700; color: #0f172a; margin-bottom: 1.25rem; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.5rem;">
          4. Đội ngũ sản xuất & Ekip (Credits)
        </h3>
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          {film.credits && film.credits.map((cr, idx) => (
            <div style="display: grid; grid-template-columns: 220px 1fr; gap: 1rem; padding: 0.6rem 0.85rem; background: #f8fafc; border-radius: 0.375rem; border: 1px solid #e2e8f0; align-items: center;">
              <div style="font-weight: 600; font-size: 0.88rem; color: #475569;">
                {cr.role}
              </div>
              <div style="font-size: 0.92rem; color: #0f172a; font-weight: 500;">
                {cr.names.join(', ')}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Right Column: Metadata & Poster -->
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
      <!-- Publishing & Status -->
      <div class="card">
        <h3 style="font-size: 1.1rem; font-weight: 700; color: #0f172a; margin-bottom: 1rem; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.5rem;">
          Trạng thái & Phân loại
        </h3>

        <div style="margin-bottom: 1rem;">
          <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 0.4rem;">
            Thể loại (Category)
          </label>
          <input 
            type="text" 
            value={film.category}
            style="width: 100%; padding: 0.6rem 0.8rem; border-radius: 0.375rem; border: 1px solid #cbd5e1; font-size: 0.9rem;"
          />
        </div>

        <div style="margin-bottom: 1rem;">
          <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 0.4rem;">
            Năm & Tiến độ (Year)
          </label>
          <input 
            type="text" 
            value={film.year}
            style="width: 100%; padding: 0.6rem 0.8rem; border-radius: 0.375rem; border: 1px solid #cbd5e1; font-size: 0.9rem;"
          />
        </div>

        <div style="margin-bottom: 1rem;">
          <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 0.4rem;">
            Thời lượng (Duration)
          </label>
          <input 
            type="text" 
            value={film.duration || ''}
            style="width: 100%; padding: 0.6rem 0.8rem; border-radius: 0.375rem; border: 1px solid #cbd5e1; font-size: 0.9rem;"
          />
        </div>

        <div style="margin-bottom: 1.25rem;">
          <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 0.4rem;">
            Quy cách kỹ thuật (Format)
          </label>
          <textarea 
            rows="2"
            style="width: 100%; padding: 0.6rem 0.8rem; border-radius: 0.375rem; border: 1px solid #cbd5e1; font-size: 0.88rem; font-family: inherit;"
          >{film.format}</textarea>
        </div>

        <button 
          type="button" 
          onclick="alert('Đã lưu thay đổi cho phim!')" 
          class="btn btn-primary" 
          style="width: 100%; justify-content: center; padding: 0.75rem;"
        >
          Cập nhật thông tin
        </button>
      </div>

      <!-- Thumbnail Preview Card -->
      <div class="card">
        <h3 style="font-size: 1.1rem; font-weight: 700; color: #0f172a; margin-bottom: 1rem; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.5rem;">
          Ảnh Thumbnail / Poster
        </h3>
        <div style="border-radius: 0.5rem; overflow: hidden; border: 1px solid #cbd5e1; margin-bottom: 0.85rem; background: #0f172a;">
          <img 
            src={film.thumbnail} 
            alt={film.title}
            style="width: 100%; height: auto; display: block;" 
          />
        </div>
        <label style="display: block; font-size: 0.8rem; font-weight: 600; color: #64748b; margin-bottom: 0.3rem;">
          Đường dẫn ảnh Thumbnail:
        </label>
        <input 
          type="text" 
          value={film.thumbnail} 
          style="width: 100%; padding: 0.55rem 0.75rem; border-radius: 0.375rem; border: 1px solid #cbd5e1; font-size: 0.82rem; font-family: monospace;"
        />
      </div>
    </div>
  </div>
</AdminLayout>
