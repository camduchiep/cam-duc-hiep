      <!-- Modal Body -->
      <div style="padding: 1.5rem; overflow-y: auto; display: flex; flex-direction: column; gap: 1.25rem;">
        <!-- Input Choice (hidden if re-cropping existing image) -->
        <div id="modal-input-sources" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; background: #f1f5f9; padding: 1rem; border-radius: 0.5rem;">
          <!-- Option A: Upload to R2 -->
          <div>
