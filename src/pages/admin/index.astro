            </label>
            <div style="display: flex; gap: 0.5rem;">
              <input type="text" id="modal-link-input" placeholder="https://storage.hiepcm.com/..." style="flex: 1; padding: 0.45rem 0.65rem; border-radius: 0.375rem; border: 1px solid #cbd5e1; font-size: 0.85rem;" />
              <button type="button" id="btn-load-link" class="btn btn-secondary" style="padding: 0.45rem 0.75rem; font-size: 0.82rem; color: #313030;">Tải ảnh</button>
            </div>
          </div>
        </div>

        <!-- Re-crop Notice -->
        <div id="modal-recrop-notice" style="display: none; background: #f1f5f9; border: 1px solid #cbd5e1; color: #313030; padding: 0.75rem 1rem; border-radius: 0.5rem; font-size: 0.88rem; font-weight: 500;">
          ✂️ <strong>Đang Crop lại ảnh đã chọn:</strong> Bạn có thể chọn tỷ lệ phổ biến (16:9, 4:3, 1:1, ảnh gốc) hoặc kéo 4 góc tự do. Bấm "Save & Cập nhật ảnh" để áp dụng trực tiếp vào Canvas.
        </div>

        <!-- Preview & Crop Workspace -->
        <div>
          <!-- Ratio Presets & Cropper Tools Bar -->
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem; flex-wrap: wrap; gap: 0.5rem;">
            <!-- Aspect Ratio Buttons -->
            <div style="display: flex; align-items: center; gap: 0.3rem; flex-wrap: wrap;">
              <span style="font-size: 0.8rem; font-weight: 700; color: #545454; margin-right: 0.2rem;">Tỷ lệ:</span>
              <button type="button" class="btn-crop-ratio tb-btn active" data-ratio="free" title="Kéo 4 góc tự do không giới hạn">Tự do</button>
              <button type="button" class="btn-crop-ratio tb-btn" data-ratio="original" title="Giữ đúng tỷ lệ ảnh gốc nhưng cho phép co nhỏ lại để cắt bớt viền">Ảnh gốc</button>
              <button type="button" class="btn-crop-ratio tb-btn" data-ratio="16:9" title="Tỷ lệ 16:9 ngang chuẩn video/màn hình">16:9</button>
              <button type="button" class="btn-crop-ratio tb-btn" data-ratio="4:3" title="Tỷ lệ 4:3 điện ảnh truyền thống">4:3</button>
              <button type="button" class="btn-crop-ratio tb-btn" data-ratio="1:1" title="Tỷ lệ vuông 1:1">1:1</button>
              <button type="button" class="btn-crop-ratio tb-btn" data-ratio="3:2" title="Tỷ lệ máy ảnh 3:2">3:2</button>
              <button type="button" class="btn-crop-ratio tb-btn" data-ratio="2.39:1" title="Tỷ lệ điện ảnh rộng Cinemascope">2.39:1</button>
              <button type="button" class="btn-crop-ratio tb-btn" data-ratio="9:16" title="Tỷ lệ khung dọc 9:16">9:16</button>
            </div>

            <!-- Cropper Controls -->
            <div style="display: flex; gap: 0.35rem;">
              <button type="button" id="btn-crop-rotate" class="tb-btn" style="font-size: 0.8rem;" title="Xoay ảnh 90 độ">🔄 Xoay 90°</button>
              <button type="button" id="btn-crop-reset" class="tb-btn" style="font-size: 0.8rem;" title="Đặt lại khung crop">↺ Reset</button>
            </div>
          </div>

          <!-- Cropper Container -->
          <div style="width: 100%; height: 380px; background: #313030; border-radius: 0.5rem; overflow: hidden; display: flex; align-items: center; justify-content: center; position: relative;">
            <img id="cropper-target-img" src="" alt="Preview Target" style="max-width: 100%; display: none;" />
            <div id="cropper-empty-placeholder" style="color: #94a3b8; font-size: 0.95rem; text-align: center; padding: 1rem;">
              Chưa có ảnh. Vui lòng chọn file tải lên hoặc dán link ảnh từ R2 vào ô phía trên để bắt đầu Preview & Crop.
            </div>
