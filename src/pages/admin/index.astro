    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- MODAL 2: FULL WEBSITE PREVIEW (Khớp font & cỡ chữ chính xác)             -->
  <!-- ========================================================================= -->
  <div id="preview-modal" class="modal-overlay" style="padding: 0; background: #ffffff;">
    <div style="width: 100%; height: 100vh; display: flex; flex-direction: column;">
      <!-- Floating Top Control Bar -->
      <div style="height: 54px; background: #313030; color: #ffffff; padding: 0 2rem; display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; border-bottom: 1px solid #545454;">
        <div style="display: flex; align-items: center; gap: 0.75rem; font-size: 0.9rem; font-weight: 500;">
          <span style="display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: #22c55e;"></span>
          Chế độ xem trước website thực tế (Fraunces 25px / Inter 16px, 15px, 13px / #313030)
        </div>
        <div style="display: flex; gap: 0.75rem;">
          <button type="button" id="btn-preview-close" class="btn btn-outline" style="color: #ffffff; border-color: #545454; padding: 0.35rem 0.85rem; font-size: 0.82rem;">
            ✕ Đóng Preview
          </button>
          <button type="button" id="btn-preview-save-direct" class="btn btn-primary" style="background: #545454; padding: 0.35rem 1rem; font-size: 0.82rem;">
