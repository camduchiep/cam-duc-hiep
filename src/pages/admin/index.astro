---
import AdminLayout from '../../layouts/AdminLayout.astro';

export const prerender = false;

interface Post {
  id: number;
  title: string;
  slug: string;
  excerpt: string;
  status: string;
  created_at: string;
  updated_at: string;
}

let posts: Post[] = [];
let error: string | null = null;

const db = Astro.locals.runtime?.env?.DB;

if (db) {
  try {
    const { results } = await db.prepare(
      'SELECT id, title, slug, excerpt, status, created_at, updated_at FROM posts ORDER BY created_at DESC'
    ).all<Post>();
    posts = results || [];
  } catch (err: any) {
    error = err.message || 'Không thể tải danh sách bài viết từ database.';
  }
} else {
  // Mock post if DB binding not yet available
  posts = [
    {
      id: 1,
      title: 'Chào mừng đến với website Cẩm Đức Hiệp',
      slug: 'chao-mung-den-voi-website-cam-duc-hiep',
      excerpt: 'Bài viết mẫu đầu tiên của hệ thống.',
      status: 'published',
      created_at: new Date().toISOString(),
      updated_at: new Date().toISOString()
    }
  ];
}
---

<AdminLayout title="Bảng điều khiển" activeTab="posts">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <div>
      <h1 style="font-size: 1.75rem; font-weight: 700; color: #0f172a;">Quản lý bài viết</h1>
      <p style="color: #64748b; font-size: 0.95rem; margin-top: 0.25rem;">
        Tổng cộng {posts.length} bài viết
      </p>
    </div>
    <a href="/admin/them-moi" class="btn btn-primary">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Viết bài mới
    </a>
  </div>

  {error && (
    <div style="background: #fee2e2; border: 1px solid #ef4444; color: #991b1b; padding: 1rem; border-radius: 0.5rem; margin-bottom: 1.5rem;">
      {error}
    </div>
  )}

  <div class="card" style="padding: 0; overflow: hidden;">
    <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.95rem;">
      <thead>
        <tr style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #64748b; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em;">
          <th style="padding: 1rem 1.5rem;">Tiêu đề bài viết</th>
          <th style="padding: 1rem 1.5rem; width: 150px;">Trạng thái</th>
          <th style="padding: 1rem 1.5rem; width: 180px;">Ngày tạo</th>
          <th style="padding: 1rem 1.5rem; width: 180px; text-align: right;">Hành động</th>
        </tr>
      </thead>
      <tbody>
        {posts.length === 0 ? (
          <tr>
            <td colspan="4" style="padding: 3rem; text-align: center; color: #94a3b8;">
              Chưa có bài viết nào. Hãy bấm <strong>Viết bài mới</strong> để bắt đầu!
            </td>
          </tr>
        ) : (
          posts.map((post) => (
            <tr style="border-bottom: 1px solid #f1f5f9; transition: background 0.15s;" onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background='transparent'">
              <td style="padding: 1.25rem 1.5rem;">
                <div style="font-weight: 600; color: #0f172a; font-size: 1rem;">
                  {post.title}
                </div>
                <div style="color: #94a3b8; font-size: 0.85rem; margin-top: 0.25rem;">
                  /{post.slug}
                </div>
              </td>
              <td style="padding: 1.25rem 1.5rem;">
                {post.status === 'published' ? (
                  <span style="display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.25rem 0.65rem; border-radius: 9999px; font-size: 0.8rem; font-weight: 600; background: #dcfce7; color: #166534;">
                    ● Đã xuất bản
                  </span>
                ) : (
                  <span style="display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.25rem 0.65rem; border-radius: 9999px; font-size: 0.8rem; font-weight: 600; background: #fef9c3; color: #854d0e;">
                    ○ Bản nháp
                  </span>
                )}
              </td>
              <td style="padding: 1.25rem 1.5rem; color: #64748b; font-size: 0.85rem;">
                {new Date(post.created_at).toLocaleDateString('vi-VN', { year: 'numeric', month: 'short', day: 'numeric' })}
              </td>
              <td style="padding: 1.25rem 1.5rem; text-align: right;">
                <div style="display: inline-flex; gap: 0.5rem; align-items: center;">
                  <a href={`/bai-viet/${post.slug}`} target="_blank" style="padding: 0.35rem 0.6rem; border-radius: 0.375rem; background: #f1f5f9; color: #475569; font-size: 0.85rem; text-decoration: none;" title="Xem bài viết">
                    Xem
                  </a>
                  <a href={`/admin/sua/${post.id}`} style="padding: 0.35rem 0.6rem; border-radius: 0.375rem; background: #e0f2fe; color: #0369a1; font-size: 0.85rem; font-weight: 600; text-decoration: none;" title="Chỉnh sửa">
                    Sửa
                  </a>
                  <button type="button" class="delete-btn" data-id={post.id} data-title={post.title} style="padding: 0.35rem 0.6rem; border-radius: 0.375rem; background: #fee2e2; color: #b91c1c; border: none; font-size: 0.85rem; cursor: pointer;" title="Xóa bài">
                    Xóa
                  </button>
                </div>
              </td>
            </tr>
          ))
        )}
      </tbody>
    </table>
  </div>

  <script>
    document.querySelectorAll('.delete-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        const title = btn.getAttribute('data-title');
        if (!confirm(`Bạn có chắc chắn muốn xóa bài viết:\n"${title}"?`)) {
          return;
        }

        try {
          const res = await fetch(`/api/posts/${id}`, { method: 'DELETE' });
          const data = await res.json();
          if (res.ok && data.success) {
            alert('Đã xóa bài viết thành công.');
            window.location.reload();
          } else {
            alert(data.error || 'Có lỗi xảy ra khi xóa.');
          }
        } catch (err) {
          alert('Lỗi kết nối máy chủ.');
        }
      });
    });
  </script>
</AdminLayout>
