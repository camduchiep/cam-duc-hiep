      <!-- Preview Body (Exact mimic of the live website) -->
      <div style="flex: 1; overflow-y: auto; display: flex; background: #ffffff;">
        <!-- Left Sidebar (Mimics Layout.astro) -->
        <aside style="width: 280px; flex-shrink: 0; padding: 75px 40px 75px 70px; border-right: none; background: #ffffff;">
          <nav style="display: flex; flex-direction: column;">
            <div style="font-size: 1rem; font-weight: 600; color: #313030; letter-spacing: -0.01em; margin-bottom: 0.65rem;">
              Films
            </div>
            <ul id="preview-sidebar-films" style="list-style: none; display: flex; flex-direction: column; gap: 0.5rem; padding-left: 0; margin-bottom: 2.25rem;">
              <!-- Dynamic film items -->
            </ul>
            <div style="display: flex; flex-direction: column; gap: 0.65rem;">
              <span style="font-size: 1rem; font-weight: 600; color: #313030; letter-spacing: -0.01em;">About</span>
              <span style="font-size: 1rem; font-weight: 600; color: #313030; letter-spacing: -0.01em;">CV</span>
            </div>
          </nav>
        </aside>

        <!-- Main Content Mimic (Mimics /films/[slug].astro) -->
        <main style="flex: 1; min-width: 0; padding: 75px 60px 100px 30px; background: #ffffff;">
          <div style="display: flex; align-items: flex-start; gap: clamp(60px, 6vw, 100px); width: 100%;">
            <!-- Content Column -->
            <div style="max-width: 840px; width: 100%; display: flex; flex-direction: column;">
              <!-- Tên phim: font Fraunces, cỡ chữ 25px, màu #313030 -->
              <h1 id="preview-film-title" style="font-family: 'Fraunces', Georgia, serif; font-size: 25px; font-weight: 400; color: #313030; letter-spacing: -0.01em; line-height: 1.25; margin-bottom: 8px;">
                <!-- Film title -->
              </h1>

              <!-- Thông số: font Inter, cỡ chữ 16px, màu #545454 -->
              <p id="preview-film-format" style="font-family: 'Inter', system-ui, sans-serif; font-size: 16px; color: #545454; margin-bottom: 28px; line-height: 1.5;">
                <!-- Film format -->
              </p>

              <!-- Text trên canvas: font Inter, cỡ chữ 15px, màu #313030 -->
              <div id="preview-canvas-render" style="font-family: 'Inter', system-ui, sans-serif; font-size: 15px; line-height: 1.4; color: #313030;">
                <!-- Canvas HTML content -->
              </div>
            </div>

            <!-- Credits Column: font Inter, cỡ chữ 13px -->
            <aside id="preview-film-credits" style="width: 260px; flex-shrink: 0; padding-top: 4px; display: flex; flex-direction: column; gap: 20px; font-family: 'Inter', system-ui, sans-serif;">
              <!-- Film credits -->
            </aside>
          </div>
        </main>
      </div>
    </div>
  </div>

  <!-- Raw initial films data for client-side JavaScript -->
  <script id="raw-films-data" type="application/json" set:html={JSON.stringify(films)}></script>

  <!-- ========================================================================= -->
  <!-- CLIENT JAVASCRIPT LOGIC                                                   -->
  <!-- ========================================================================= -->
  <script is:inline>
    // 1. Data initialization
    const rawFilmsElement = document.getElementById('raw-films-data');
    let allFilms = JSON.parse(rawFilmsElement ? rawFilmsElement.textContent : '[]');
    let currentFilmSlug = allFilms[0] ? allFilms[0].slug : '';

    // DOM Elements
    const selector = document.getElementById('film-selector');
    const titleInput = document.getElementById('film-title-input');
    const formatInput = document.getElementById('film-format-input');
    const slugInput = document.getElementById('film-slug-input');
    const canvasEditor = document.getElementById('canvas-editor');
    const creditsList = document.getElementById('credits-list');
    const addCreditBtn = document.getElementById('btn-add-credit');
    const saveFilmBtn = document.getElementById('btn-save-film');
    const viewLiveBtn = document.getElementById('btn-view-live');
    const saveStatusBanner = document.getElementById('save-status-banner');

    // Toolbar Elements
    const tbUndo = document.getElementById('tb-undo');
    const tbRedo = document.getElementById('tb-redo');
    const tbFontSize = document.getElementById('tb-fontsize');
    const tbColor = document.getElementById('tb-color');
    const tbLineHeight = document.getElementById('tb-lineheight');
    const tbParaMargin = document.getElementById('tb-paramargin');
    const btnInsertImage = document.getElementById('btn-insert-image');

    // Image Modal Elements
    const imgModal = document.getElementById('image-modal');
    const modalHeading = document.getElementById('modal-title-heading');
    const modalSubHeading = document.getElementById('modal-subtitle-heading');
    const modalInputSources = document.getElementById('modal-input-sources');
    const modalRecropNotice = document.getElementById('modal-recrop-notice');
    const modalCloseBtn = document.getElementById('btn-modal-close');
    const modalCancelBtn = document.getElementById('btn-modal-cancel');
    const modalSaveBtn = document.getElementById('btn-modal-save');
    const modalFileInput = document.getElementById('modal-file-input');
    const modalLinkInput = document.getElementById('modal-link-input');
    const btnLoadLink = document.getElementById('btn-load-link');
    const cropperTargetImg = document.getElementById('cropper-target-img');
    const cropperPlaceholder = document.getElementById('cropper-empty-placeholder');
    const modalUploadLoading = document.getElementById('modal-upload-loading');
    const btnCropRotate = document.getElementById('btn-crop-rotate');
    const btnCropReset = document.getElementById('btn-crop-reset');

    // Floating Image Toolbar Elements
    const imgFloatingToolbar = document.getElementById('img-floating-toolbar');
    const btnImgRecrop = document.getElementById('btn-img-recrop');
    const btnImgMoveUp = document.getElementById('btn-img-move-up');
    const btnImgMoveDown = document.getElementById('btn-img-move-down');
    const btnImgDelete = document.getElementById('btn-img-delete');
    let selectedImageElement = null;

    // Full Preview Elements
    const previewModal = document.getElementById('preview-modal');
    const btnOpenPreview = document.getElementById('btn-open-preview');
    const btnPreviewClose = document.getElementById('btn-preview-close');
    const btnPreviewSaveDirect = document.getElementById('btn-preview-save-direct');
    const previewFilmTitle = document.getElementById('preview-film-title');
    const previewFilmFormat = document.getElementById('preview-film-format');
    const previewCanvasRender = document.getElementById('preview-canvas-render');
    const previewFilmCredits = document.getElementById('preview-film-credits');
    const previewSidebarFilms = document.getElementById('preview-sidebar-films');

    let cropper = null;
    let savedSelectionRange = null;
    let isReCropping = false;
    let activeReCropImg = null;
    let draggedWrapper = null;
    let currentSelectedRatio = 'free';

    // Undo / Redo
    let historyStack = [];
    let historyIndex = -1;
    const MAX_HISTORY = 60;
    let debounceTimer = null;

    function updateUndoRedoButtons() {
      tbUndo.disabled = historyIndex <= 0;
      tbRedo.disabled = historyIndex >= historyStack.length - 1;
    }

    function recordHistory(force = false) {
      const currentHTML = canvasEditor.innerHTML;
      if (!force && historyStack.length > 0 && historyStack[historyIndex] === currentHTML) {
        return;
      }

      if (historyIndex < historyStack.length - 1) {
        historyStack = historyStack.slice(0, historyIndex + 1);
      }

      historyStack.push(currentHTML);
      if (historyStack.length > MAX_HISTORY) {
        historyStack.shift();
      } else {
        historyIndex++;
      }

      updateUndoRedoButtons();
    }

    function undo() {
      if (historyIndex > 0) {
        historyIndex--;
        canvasEditor.innerHTML = historyStack[historyIndex];
        ensureDraggableImages();
        if (selectedImageElement) {
          selectedImageElement.classList.remove('selected-img');
          selectedImageElement = null;
        }
        imgFloatingToolbar.style.display = 'none';
        updateUndoRedoButtons();
      }
    }

    function redo() {
      if (historyIndex < historyStack.length - 1) {
        historyIndex++;
        canvasEditor.innerHTML = historyStack[historyIndex];
        ensureDraggableImages();
        if (selectedImageElement) {
          selectedImageElement.classList.remove('selected-img');
          selectedImageElement = null;
        }
        imgFloatingToolbar.style.display = 'none';
        updateUndoRedoButtons();
      }
    }

    tbUndo.addEventListener('click', undo);
    tbRedo.addEventListener('click', redo);

    canvasEditor.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        recordHistory();
      }, 400);
    });

    window.addEventListener('keydown', (e) => {
      if (document.activeElement === canvasEditor || canvasEditor.contains(document.activeElement) || selectedImageElement) {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'z') {
          if (e.shiftKey) {
            e.preventDefault();
            redo();
          } else {
            e.preventDefault();
            undo();
          }
        } else if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'y') {
          e.preventDefault();
          redo();
        }
      }
    });

    // 2. Load Film Data into Canvas Form
    function loadFilm(slug) {
      if (slug === '__NEW_FILM__') {
        currentFilmSlug = '';
        titleInput.value = '';
        titleInput.placeholder = 'ví dụ: a tale of King Kong | sự tích con khỉ';
        formatInput.value = '';
        formatInput.placeholder = 'ví dụ: Essay film | 15\' | 2027 | Vietnam';
        slugInput.value = '';
        slugInput.placeholder = 'vi-du-ten-phim';
        canvasEditor.innerHTML = '<p style="font-size: 15px; line-height: 1.4; color: #313030; margin-bottom: 24px;">Nhập tóm tắt hoặc nội dung giới thiệu tác phẩm tại đây...</p><p style="font-size: 15px; line-height: 1.4; color: #313030; margin-bottom: 24px;"><br></p>';
        renderCredits([
          { role: 'Directed by', name: 'Cầm Đức Hiệp' },
          { role: 'Written by', name: 'Cầm Đức Hiệp' },
          { role: 'Produced by', name: '' },
          { role: 'Director of Photography', name: '' },
          { role: 'Edited by', name: '' },
          { role: 'Sound', name: '' }
        ]);
        viewLiveBtn.style.display = 'none';
        ensureDraggableImages();
        historyStack = [canvasEditor.innerHTML];
        historyIndex = 0;
        updateUndoRedoButtons();
        return;
      }

      const film = allFilms.find(f => f.slug === slug);
      if (!film) return;

      currentFilmSlug = film.slug;
      titleInput.value = film.title || '';
      formatInput.value = film.format || '';
      slugInput.value = film.slug || '';
      canvasEditor.innerHTML = film.content_html || '<p style="font-size: 15px; color: #313030;"></p>';
      
      const credits = film.credits && film.credits.length > 0
        ? film.credits.map(c => ({
            role: c.role || '',
            name: Array.isArray(c.names) ? c.names.join(', ') : (c.name || c.names || '')
          }))
        : [{ role: 'Directed by', name: 'Cầm Đức Hiệp' }];

      renderCredits(credits);

      viewLiveBtn.href = `/films/${film.slug}`;
      viewLiveBtn.style.display = 'inline-flex';

      ensureDraggableImages();

      historyStack = [canvasEditor.innerHTML];
      historyIndex = 0;
      updateUndoRedoButtons();
    }

    // 3. Render Credits Rows (Font Inter, Cỡ chữ 13px)
    function renderCredits(credits) {
      creditsList.innerHTML = '';
      if (!credits || credits.length === 0) {
        credits = [{ role: '', name: '' }];
      }

      credits.forEach((cr) => {
        const row = document.createElement('div');
        row.className = 'credit-row';
        row.style.cssText = 'display: grid; grid-template-columns: 240px 1fr 38px; gap: 0.75rem; align-items: center;';
        row.innerHTML = `
          <input type="text" placeholder="Role (e.g. Directed by)" value="${cr.role || ''}" class="credit-role" style="padding: 0.6rem 0.85rem; border: 1px solid #cbd5e1; border-radius: 0.375rem; font-family: 'Inter', system-ui, sans-serif; font-size: 13px; color: #545454;" />
          <input type="text" placeholder="Tên thành viên (e.g. Cầm Đức Hiệp)" value="${cr.name || ''}" class="credit-name" style="padding: 0.6rem 0.85rem; border: 1px solid #cbd5e1; border-radius: 0.375rem; font-family: 'Inter', system-ui, sans-serif; font-size: 13px; color: #313030;" />
          <button type="button" class="btn-del-credit tb-btn btn-danger" style="height: 38px; width: 38px; border-radius: 0.375rem; padding: 0; font-size: 1rem;" title="Xóa người này">✕</button>
        `;

        row.querySelector('.btn-del-credit').addEventListener('click', () => {
          row.remove();
          if (creditsList.children.length === 0) {
            renderCredits([{ role: '', name: '' }]);
          }
        });

        creditsList.appendChild(row);
      });
    }

    addCreditBtn.addEventListener('click', () => {
      const row = document.createElement('div');
      row.className = 'credit-row';
      row.style.cssText = 'display: grid; grid-template-columns: 240px 1fr 38px; gap: 0.75rem; align-items: center;';
      row.innerHTML = `
        <input type="text" placeholder="Role (e.g. Producer)" value="" class="credit-role" style="padding: 0.6rem 0.85rem; border: 1px solid #cbd5e1; border-radius: 0.375rem; font-family: 'Inter', system-ui, sans-serif; font-size: 13px; color: #545454;" />
        <input type="text" placeholder="Tên thành viên" value="" class="credit-name" style="padding: 0.6rem 0.85rem; border: 1px solid #cbd5e1; border-radius: 0.375rem; font-family: 'Inter', system-ui, sans-serif; font-size: 13px; color: #313030;" />
        <button type="button" class="btn-del-credit tb-btn btn-danger" style="height: 38px; width: 38px; border-radius: 0.375rem; padding: 0; font-size: 1rem;" title="Xóa người này">✕</button>
      `;
      row.querySelector('.btn-del-credit').addEventListener('click', () => {
        row.remove();
      });
      creditsList.appendChild(row);
    });

    selector.addEventListener('change', (e) => {
      loadFilm(e.target.value);
    });

    titleInput.addEventListener('input', () => {
      if (selector.value === '__NEW_FILM__') {
        const rawTitle = titleInput.value.split('|')[0] || titleInput.value;
        const genSlug = rawTitle
          .toLowerCase()
          .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
          .replace(/[đĐ]/g, 'd')
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-+|-+$/g, '');
        slugInput.value = genSlug;
      }
    });

    // 4. Formatting Tools Implementation
    tbFontSize.addEventListener('change', (e) => {
      const size = e.target.value;
      const selection = window.getSelection();
      if (!selection.rangeCount) return;
      const range = selection.getRangeAt(0);
      const span = document.createElement('span');
      span.style.fontSize = size;
      span.appendChild(range.extractContents());
      range.insertNode(span);
      recordHistory(true);
    });

    tbColor.addEventListener('input', (e) => {
      document.execCommand('foreColor', false, e.target.value);
      recordHistory(true);
    });

    tbLineHeight.addEventListener('change', (e) => {
      const lh = e.target.value;
      canvasEditor.style.lineHeight = lh;
      const selection = window.getSelection();
      if (selection.anchorNode) {
        let parent = selection.anchorNode.parentElement;
        while (parent && parent !== canvasEditor) {
          if (parent.tagName === 'P' || parent.tagName === 'DIV') {
            parent.style.lineHeight = lh;
            break;
          }
          parent = parent.parentElement;
        }
      }
      recordHistory(true);
    });

    tbParaMargin.addEventListener('change', (e) => {
      const margin = e.target.value;
      const pElements = canvasEditor.querySelectorAll('p');
      pElements.forEach(p => {
        p.style.marginBottom = margin;
      });
      recordHistory(true);
    });

    // 5. Image Modal & Crop System
    btnInsertImage.addEventListener('click', () => {
      isReCropping = false;
      activeReCropImg = null;
      const sel = window.getSelection();
      if (sel && sel.rangeCount > 0) {
        savedSelectionRange = sel.getRangeAt(0).cloneRange();
      }
      openImageModal(false);
    });

    function openImageModal(forReCrop = false) {
      imgModal.style.display = 'flex';
      modalSaveBtn.disabled = true;
      cropperTargetImg.style.display = 'none';
      cropperPlaceholder.style.display = 'block';

      currentSelectedRatio = 'free';
      document.querySelectorAll('.btn-crop-ratio').forEach(b => {
        if (b.getAttribute('data-ratio') === 'free') b.classList.add('active');
        else b.classList.remove('active');
      });

      if (forReCrop) {
        modalHeading.innerText = '✂️ Crop lại ảnh đã chọn trong Canvas';
        modalSubHeading.innerText = 'Chọn tỷ lệ phổ biến (16:9, 4:3, 1:1, ảnh gốc) hoặc kéo 4 góc tự do để cắt ảnh tùy thích.';
        modalInputSources.style.display = 'none';
        modalRecropNotice.style.display = 'block';
        modalSaveBtn.innerText = 'Save & Cập nhật ảnh';
      } else {
        modalHeading.innerText = 'Chèn & Chỉnh sửa ảnh (Crop tùy thích)';
        modalSubHeading.innerText = 'Tải ảnh lên Cloudflare R2 hoặc dán link R2, chọn tỷ lệ crop tùy thích trước khi insert.';
        modalInputSources.style.display = 'grid';
        modalRecropNotice.style.display = 'none';
        modalSaveBtn.innerText = 'Save & Chèn vào Canvas';
        modalFileInput.value = '';
        modalLinkInput.value = '';
      }

      if (cropper) {
        cropper.destroy();
        cropper = null;
      }
    }

    function closeImageModal() {
      imgModal.style.display = 'none';
      if (cropper) {
        cropper.destroy();
        cropper = null;
      }
      isReCropping = false;
      activeReCropImg = null;
    }

    modalCloseBtn.addEventListener('click', closeImageModal);
    modalCancelBtn.addEventListener('click', closeImageModal);

    function applyCropperRatio(ratioKey) {
      if (!cropper) return;
      currentSelectedRatio = ratioKey;

      if (ratioKey === 'free') {
        cropper.setAspectRatio(NaN);
      } else if (ratioKey === 'original') {
        const imgData = cropper.getImageData();
        if (imgData && imgData.naturalWidth && imgData.naturalHeight) {
          cropper.setAspectRatio(imgData.naturalWidth / imgData.naturalHeight);
        }
      } else if (ratioKey === '16:9') {
        cropper.setAspectRatio(16 / 9);
      } else if (ratioKey === '4:3') {
        cropper.setAspectRatio(4 / 3);
      } else if (ratioKey === '1:1') {
        cropper.setAspectRatio(1);
      } else if (ratioKey === '3:2') {
        cropper.setAspectRatio(3 / 2);
      } else if (ratioKey === '2.39:1') {
        cropper.setAspectRatio(2.39 / 1);
      } else if (ratioKey === '9:16') {
        cropper.setAspectRatio(9 / 16);
      }
    }

    document.querySelectorAll('.btn-crop-ratio').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.btn-crop-ratio').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        applyCropperRatio(btn.getAttribute('data-ratio'));
      });
    });

    function setupCropper(srcUrl) {
      if (cropper) {
        cropper.destroy();
        cropper = null;
      }

      cropperPlaceholder.style.display = 'none';
      cropperTargetImg.src = srcUrl;
      cropperTargetImg.style.display = 'block';

      cropper = new Cropper(cropperTargetImg, {
        aspectRatio: NaN,
        viewMode: 1,
        autoCropArea: 0.95,
        responsive: true,
        background: false,
        ready() {
          modalSaveBtn.disabled = false;
          if (currentSelectedRatio !== 'free') {
            applyCropperRatio(currentSelectedRatio);
          }
        }
      });
    }

    modalFileInput.addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file) return;

      modalUploadLoading.style.display = 'block';

      const reader = new FileReader();
      reader.onload = (loadEvt) => {
        setupCropper(loadEvt.target.result);
      };
      reader.readAsDataURL(file);

      const formData = new FormData();
      formData.append('file', file);
      try {
        const res = await fetch('/api/upload/r2', { method: 'POST', body: formData });
        const data = await res.json();
        if (data.success && data.url) {
          modalLinkInput.value = data.url;
        }
      } catch (err) {
        console.warn('R2 background upload error:', err);
      } finally {
        modalUploadLoading.style.display = 'none';
      }
    });

    btnLoadLink.addEventListener('click', () => {
      const url = modalLinkInput.value.trim();
      if (!url) {
        alert('Vui lòng dán link ảnh từ R2 hoặc Web vào ô nhập liệu.');
        return;
      }
      setupCropper(url);
    });

    btnCropRotate.addEventListener('click', () => {
      if (cropper) cropper.rotate(90);
    });

    btnCropReset.addEventListener('click', () => {
      if (cropper) cropper.reset();
    });

    // Save Cropped Image (Insert New OR Re-Crop)
    modalSaveBtn.addEventListener('click', async () => {
      if (!cropper) return;

      modalSaveBtn.disabled = true;
      modalSaveBtn.innerText = 'Đang xử lý ảnh...';

      const croppedCanvas = cropper.getCroppedCanvas();

      croppedCanvas.toBlob(async (blob) => {
        let finalImageUrl = '';

        if (blob) {
          const croppedFile = new File([blob], `cropped_${Date.now()}.png`, { type: 'image/png' });
          const formData = new FormData();
          formData.append('file', croppedFile);

          try {
            const uploadRes = await fetch('/api/upload/r2', { method: 'POST', body: formData });
            const uploadData = await uploadRes.json();
            if (uploadData.success && uploadData.url) {
              finalImageUrl = uploadData.url;
            }
          } catch (e) {
            console.warn('Could not upload cropped blob to R2, falling back to data URL:', e);
          }
        }

        if (!finalImageUrl) {
          finalImageUrl = croppedCanvas.toDataURL('image/png');
        }

        if (isReCropping && activeReCropImg) {
          activeReCropImg.src = finalImageUrl;
          positionFloatingToolbar(activeReCropImg);
          recordHistory(true);
        } else {
          canvasEditor.focus();
          if (savedSelectionRange) {
            const sel = window.getSelection();
            sel.removeAllRanges();
            sel.addRange(savedSelectionRange);
          }

          const imgWrapper = document.createElement('div');
          imgWrapper.className = 'canvas-img-wrapper';
          imgWrapper.setAttribute('draggable', 'true');
          imgWrapper.style.cssText = 'text-align: center; margin: 16px 0; cursor: grab;';

          const img = document.createElement('img');
          img.src = finalImageUrl;
          img.style.cssText = 'max-width: 100%; height: auto; display: inline-block; cursor: pointer;';
          imgWrapper.appendChild(img);

          const pAfter = document.createElement('p');
          pAfter.style.cssText = 'font-size: 15px; color: #313030;';
          pAfter.innerHTML = '<br/>';

          if (savedSelectionRange) {
            savedSelectionRange.insertNode(pAfter);
            savedSelectionRange.insertNode(imgWrapper);
          } else {
            canvasEditor.appendChild(imgWrapper);
            canvasEditor.appendChild(pAfter);
          }

          attachDragEventsToWrapper(imgWrapper);
          recordHistory(true);
        }

        closeImageModal();
        modalSaveBtn.disabled = false;
        modalSaveBtn.innerText = 'Save & Chèn vào Canvas';
      }, 'image/png');
    });

    // 6. Floating Image Toolbar & Re-Crop & Move Position
    function positionFloatingToolbar(img) {
      const rect = img.getBoundingClientRect();
      imgFloatingToolbar.style.display = 'flex';
      imgFloatingToolbar.style.top = `${window.scrollY + rect.top - 46}px`;
      imgFloatingToolbar.style.left = `${Math.max(10, window.scrollX + rect.left)}px`;
    }

    canvasEditor.addEventListener('click', (e) => {
      const target = e.target;
      if (target.tagName === 'IMG') {
        if (selectedImageElement) {
          selectedImageElement.classList.remove('selected-img');
        }
        selectedImageElement = target;
        selectedImageElement.classList.add('selected-img');
        positionFloatingToolbar(target);
      } else if (!e.target.closest('#img-floating-toolbar')) {
        if (selectedImageElement) {
          selectedImageElement.classList.remove('selected-img');
          selectedImageElement = null;
        }
        imgFloatingToolbar.style.display = 'none';
      }
    });

    // A: Size Buttons
    document.querySelectorAll('.btn-img-size').forEach(btn => {
      btn.addEventListener('click', () => {
        if (selectedImageElement) {
          const size = btn.getAttribute('data-size');
          selectedImageElement.style.width = size;
          selectedImageElement.style.maxWidth = '100%';
          positionFloatingToolbar(selectedImageElement);
          recordHistory(true);
        }
      });
    });

    // B: RE-CROP EXISTING IMAGE
    btnImgRecrop.addEventListener('click', () => {
      if (!selectedImageElement) return;
      isReCropping = true;
      activeReCropImg = selectedImageElement;
      openImageModal(true);
      setupCropper(selectedImageElement.src);
    });

    // C: MOVE IMAGE UP
    btnImgMoveUp.addEventListener('click', () => {
      if (!selectedImageElement) return;
      const wrapper = selectedImageElement.closest('.canvas-img-wrapper') || selectedImageElement.parentElement;
      if (!wrapper || wrapper === canvasEditor) return;

      const prev = wrapper.previousElementSibling;
      if (prev) {
        wrapper.parentElement.insertBefore(wrapper, prev);
        positionFloatingToolbar(selectedImageElement);
        recordHistory(true);
      }
    });

    // D: MOVE IMAGE DOWN
    btnImgMoveDown.addEventListener('click', () => {
      if (!selectedImageElement) return;
      const wrapper = selectedImageElement.closest('.canvas-img-wrapper') || selectedImageElement.parentElement;
      if (!wrapper || wrapper === canvasEditor) return;

      const next = wrapper.nextElementSibling;
      if (next) {
        wrapper.parentElement.insertBefore(wrapper, next.nextElementSibling);
        positionFloatingToolbar(selectedImageElement);
        recordHistory(true);
      }
    });

    // E: Delete Image Button
    btnImgDelete.addEventListener('click', () => {
      if (selectedImageElement) {
        const wrapper = selectedImageElement.closest('.canvas-img-wrapper') || selectedImageElement.parentElement;
        selectedImageElement.remove();
        if (wrapper && wrapper.children.length === 0) {
          wrapper.remove();
        }
        selectedImageElement = null;
        imgFloatingToolbar.style.display = 'none';
        recordHistory(true);
      }
    });

    // 7. DRAG-AND-DROP REORDERING OF IMAGES BETWEEN TEXT & IMAGES
    function attachDragEventsToWrapper(wrapper) {
      wrapper.setAttribute('draggable', 'true');

      wrapper.addEventListener('dragstart', (e) => {
        draggedWrapper = wrapper;
        wrapper.classList.add('dragging');
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', '');
      });

      wrapper.addEventListener('dragend', () => {
        wrapper.classList.remove('dragging');
        draggedWrapper = null;
        document.querySelectorAll('.drop-target-before, .drop-target-after').forEach(el => {
          el.classList.remove('drop-target-before', 'drop-target-after');
        });
      });
    }

    canvasEditor.addEventListener('dragover', (e) => {
      if (!draggedWrapper) return;
      e.preventDefault();
      e.dataTransfer.dropEffect = 'move';

      const target = e.target.closest('#canvas-editor > *');
      if (target && target !== draggedWrapper) {
        const rect = target.getBoundingClientRect();
        const midY = rect.top + rect.height / 2;

        document.querySelectorAll('.drop-target-before, .drop-target-after').forEach(el => {
          el.classList.remove('drop-target-before', 'drop-target-after');
        });

        if (e.clientY < midY) {
          target.classList.add('drop-target-before');
        } else {
          target.classList.add('drop-target-after');
        }
      }
    });

    canvasEditor.addEventListener('dragleave', (e) => {
      const target = e.target.closest('#canvas-editor > *');
      if (target) {
        target.classList.remove('drop-target-before', 'drop-target-after');
      }
    });

    canvasEditor.addEventListener('drop', (e) => {
      if (!draggedWrapper) return;
      e.preventDefault();

      const target = e.target.closest('#canvas-editor > *');
      if (target && target !== draggedWrapper) {
        const rect = target.getBoundingClientRect();
        const midY = rect.top + rect.height / 2;

        if (e.clientY < midY) {
          canvasEditor.insertBefore(draggedWrapper, target);
        } else {
          canvasEditor.insertBefore(draggedWrapper, target.nextElementSibling);
        }
        recordHistory(true);
      }

      document.querySelectorAll('.drop-target-before, .drop-target-after').forEach(el => {
        el.classList.remove('drop-target-before', 'drop-target-after');
      });

      if (selectedImageElement) {
        positionFloatingToolbar(selectedImageElement);
      }
    });

    function ensureDraggableImages() {
      const allImgs = canvasEditor.querySelectorAll('img');
      allImgs.forEach(img => {
        let wrapper = img.closest('.canvas-img-wrapper');
        if (!wrapper) {
          wrapper = document.createElement('div');
          wrapper.className = 'canvas-img-wrapper';
          wrapper.setAttribute('draggable', 'true');
          wrapper.style.cssText = 'text-align: center; margin: 16px 0; cursor: grab;';
          img.parentNode.insertBefore(wrapper, img);
          wrapper.appendChild(img);
        }
        attachDragEventsToWrapper(wrapper);
      });
    }

    // 8. Full Website Preview Modal (Exact typography and colors)
    btnOpenPreview.addEventListener('click', () => {
      previewSidebarFilms.innerHTML = '';
      allFilms.forEach(f => {
        const li = document.createElement('li');
        const isCurrent = f.slug === slugInput.value.trim();
        li.innerHTML = `
          <span style="font-size: 0.92rem; display: block; ${isCurrent ? 'color: #545454; font-weight: 400;' : 'color: #313030; font-weight: 500;'}">
            ${f.title.split('|')[0].trim()}
          </span>
        `;
        previewSidebarFilms.appendChild(li);
      });

      // Tên phim: font Fraunces, cỡ chữ 25px, màu #313030
      previewFilmTitle.innerText = titleInput.value.trim() || 'Chưa đặt tiêu đề';
      previewFilmTitle.style.fontFamily = "'Fraunces', Georgia, serif";
      previewFilmTitle.style.fontSize = "25px";
      previewFilmTitle.style.color = "#313030";

      // Thông số: font Inter, cỡ chữ 16px, màu #545454
      previewFilmFormat.innerText = formatInput.value.trim() || '';
      previewFilmFormat.style.fontFamily = "'Inter', system-ui, sans-serif";
      previewFilmFormat.style.fontSize = "16px";
      previewFilmFormat.style.color = "#545454";

      // Text trên canvas: font Inter, cỡ chữ 15px, màu #313030
      previewCanvasRender.innerHTML = canvasEditor.innerHTML;
      previewCanvasRender.style.fontFamily = "'Inter', system-ui, sans-serif";
      previewCanvasRender.style.fontSize = "15px";
      previewCanvasRender.style.lineHeight = "1.4";
      previewCanvasRender.style.color = "#313030";

      // Credit: font Inter, cỡ chữ 13px: role #545454, name #313030
      previewFilmCredits.innerHTML = '';
      previewFilmCredits.style.fontFamily = "'Inter', system-ui, sans-serif";
      previewFilmCredits.style.fontSize = "13px";

      const creditRows = creditsList.querySelectorAll('.credit-row');
      creditRows.forEach(row => {
        const role = row.querySelector('.credit-role').value.trim();
        const name = row.querySelector('.credit-name').value.trim();
        if (role || name) {
          const div = document.createElement('div');
          div.style.cssText = 'display: flex; flex-direction: column; gap: 2px;';
          div.innerHTML = `
            <div style="font-size: 13px; color: #545454; font-weight: 400; line-height: 1.4;">${role}</div>
            <div style="font-size: 13px; color: #313030; font-weight: 400; line-height: 1.4;">${name}</div>
          `;
          previewFilmCredits.appendChild(div);
        }
      });

      previewModal.style.display = 'block';
    });

    btnPreviewClose.addEventListener('click', () => {
      previewModal.style.display = 'none';
    });

    btnPreviewSaveDirect.addEventListener('click', () => {
      saveFilmAction();
      previewModal.style.display = 'none';
    });

    // 9. Save Film to CMS Action
    async function saveFilmAction() {
      const slug = slugInput.value.trim();
      const title = titleInput.value.trim();
      const format = formatInput.value.trim();

      if (selectedImageElement) {
        selectedImageElement.classList.remove('selected-img');
      }
      imgFloatingToolbar.style.display = 'none';

      const contentHtml = canvasEditor.innerHTML;

      if (!title || !slug) {
        alert('Vui lòng nhập đầy đủ Tiêu đề và Slug của phim.');
        return;
      }

      saveFilmBtn.disabled = true;
      saveFilmBtn.innerText = 'Đang lưu vào CMS...';
      saveStatusBanner.style.display = 'none';

      const credits = [];
      const rows = creditsList.querySelectorAll('.credit-row');
      rows.forEach(r => {
        const role = r.querySelector('.credit-role').value.trim();
        const name = r.querySelector('.credit-name').value.trim();
        if (role || name) {
          credits.push({ role, name });
        }
      });

      const payload = {
        slug,
        title,
        format,
        content_html: contentHtml,
        credits
      };

      try {
        const res = await fetch('/api/films/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();
        if (res.ok && data.success) {
          saveStatusBanner.style.display = 'block';
          saveStatusBanner.style.background = '#dcfce7';
          saveStatusBanner.style.color = '#166534';
          saveStatusBanner.style.border = '1px solid #bbf7d0';
          saveStatusBanner.innerHTML = `
            ✓ Đã lưu thành công vào CMS! Tác phẩm <strong>"${title}"</strong> đã được cập nhật trực tiếp ra website.
            <a href="/films/${slug}" target="_blank" style="margin-left: 1rem; color: #0284c7; font-weight: 700; text-decoration: underline;">
              Xem trang phim ngay ↗
            </a>
          `;

          const existingIdx = allFilms.findIndex(f => f.slug === slug);
          if (existingIdx >= 0) {
            allFilms[existingIdx] = data.film;
          } else {
            allFilms.push(data.film);
            const opt = document.createElement('option');
            opt.value = slug;
            opt.innerText = title;
            selector.insertBefore(opt, selector.lastElementChild);
            selector.value = slug;
          }

          viewLiveBtn.href = `/films/${slug}`;
          viewLiveBtn.style.display = 'inline-flex';
        } else {
          saveStatusBanner.style.display = 'block';
          saveStatusBanner.style.background = '#fee2e2';
          saveStatusBanner.style.color = '#991b1b';
          saveStatusBanner.style.border = '1px solid #ef4444';
          saveStatusBanner.innerText = data.error || 'Có lỗi xảy ra khi lưu phim.';
        }
      } catch (err) {
        saveStatusBanner.style.display = 'block';
        saveStatusBanner.style.background = '#fee2e2';
        saveStatusBanner.style.color = '#991b1b';
        saveStatusBanner.style.border = '1px solid #ef4444';
        saveStatusBanner.innerText = 'Lỗi kết nối máy chủ.';
      } finally {
        saveFilmBtn.disabled = false;
        saveFilmBtn.innerHTML = `
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
          Lưu thay đổi (Save)
        `;
      }
    }

    saveFilmBtn.addEventListener('click', saveFilmAction);

    // Initial load: check URL query params for ?new=1 or ?slug=xxx
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('new') === '1' || urlParams.get('action') === 'new') {
      selector.value = '__NEW_FILM__';
      loadFilm('__NEW_FILM__');
    } else if (urlParams.get('slug')) {
      const targetSlug = urlParams.get('slug');
      if (allFilms.some(f => f.slug === targetSlug)) {
        selector.value = targetSlug;
        loadFilm(targetSlug);
      } else if (allFilms && allFilms.length > 0) {
        loadFilm(allFilms[0].slug);
      }
    } else if (allFilms && allFilms.length > 0) {
      loadFilm(allFilms[0].slug);
    }
  </script>
</AdminLayout>
