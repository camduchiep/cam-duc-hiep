        </div>
      </div>

      <!-- Modal Footer -->
      <div style="padding: 1rem 1.5rem; border-top: 1px solid #e2e8f0; display: flex; justify-content: flex-end; gap: 0.75rem; background: #f8fafc;">
        <button type="button" id="btn-modal-cancel" class="btn btn-outline" style="color: #545454; border-color: #cbd5e1;">
          Cancel (Hủy)
        </button>
        <button type="button" id="btn-modal-save" class="btn btn-primary" style="background: #313030;" disabled>
          Save & Chèn vào Canvas
        </button>
