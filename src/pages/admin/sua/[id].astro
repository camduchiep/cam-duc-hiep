---
import AdminLayout from '../../../layouts/AdminLayout.astro';

export const prerender = false;

const { id } = Astro.params;
const db = Astro.locals.runtime?.env?.DB;

interface Post {
  id: number;
  title: string;
  slug: string;
  excerpt: string;
  content: string;
  cover_image: string;
  status: string;
}

let post: Post | null = null;
let error: string | null = null;

if (db && id) {
  try {
    post = await db.prepare('SELECT * FROM posts WHERE id = ?').bind(id).first<Post>();
    if (!post) {
      error = 'Không tìm thấy bài viết.';
    }
  } catch (err: any) {
    error = err.message || 'Lỗi truy vấn cơ sở dữ liệu.';
  }
} else {
  // Mock post if DB not connected yet
  post = {
    id: Number(id) || 1,
    title: 'Chào mừng đến với website Cẩm Đức Hiệp',
    slug: 'chao-mung-den-voi-website-cam-duc-hiep',
    excerpt: 'Bài viết mẫu đầu tiên của hệ thống.',
    content: '<h2>Xin chào!</h2><p>Nội dung mẫu bài viết.</p>',
    cover_image: 'https://images.unsplash.com/photo-1499750310107-5fef28a66643?auto=format&fit=crop&w=1200&q=80',
    status: 'published'
  };
}
---

<AdminLayout title={`Sửa bài: ${post?.title || ''}`}>
  <div style="margin-bottom: 2rem;">
    <a href="/admin" style="color: #64748b; font-size: 0.9rem; text-decoration: none; display: inline-flex; align-items: center; gap: 0.3rem;">
      ← Quay lại danh sách
    </a>
    <h1 style="font-size: 1.75rem; font-weight: 700; color: #0f172a; margin-top: 0.5rem;">Chỉnh sửa bài viết</h1>
  </div>

  {error && (
    <div style="background: #fee2e2; border: 1px solid #ef4444; color: #991b1b; padding: 1rem; border-radius: 0.5rem; margin-bottom: 1.5rem;">
      {error}
    </div>
  )}

  {post && (
    <form id="edit-form" data-id={post.id}>
      <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 2rem; align-items: start;">
        <!-- Left Column: Main Editor -->
        <div style="display: flex; flex-direction: column; gap: 1.5rem;">
          <div class="card">
            <label style="display: block; font-weight: 600; font-size: 0.95rem; margin-bottom: 0.5rem; color: #334155;">
              Tiêu đề bài viết <span style="color: #ef4444;">*</span>
            </label>
            <input 
              type="text" 
              name="title" 
              id="post-title" 
              value={post.title}
              required 
              style="width: 100%; padding: 0.85rem 1rem; border-radius: 0.5rem; border: 1px solid #cbd5e1; font-size: 1.2rem; font-weight: 600; color: #0f172a;"
            />
          </div>

          <div class="card">
            <label style="display: block; font-weight: 600; font-size: 0.95rem; margin-bottom: 0.5rem; color: #334155;">
              Nội dung bài viết <span style="color: #ef4444;">*</span>
            </label>
            <div id="quill-editor"></div>
            <input type="hidden" name="content" id="post-content" />
            <!-- Store original content for script initialization -->
            <div id="raw-content" style="display: none;" set:html={post.content}></div>
          </div>

          <div class="card">
            <label style="display: block; font-weight: 600; font-size: 0.95rem; margin-bottom: 0.5rem; color: #334155;">
              Đoạn trích tóm tắt (Excerpt)
            </label>
            <textarea 
              name="excerpt" 
              rows="3" 
              style="width: 100%; padding: 0.75rem 1rem; border-radius: 0.5rem; border: 1px solid #cbd5e1; font-family: inherit; font-size: 0.95rem; color: #334155;"
            >{post.excerpt}</textarea>
          </div>
        </div>

        <!-- Right Column: Settings & Publishing -->
        <div style="display: flex; flex-direction: column; gap: 1.5rem;">
          <div class="card">
            <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 1rem; color: #0f172a; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.5rem;">
              Cập nhật
            </h3>

            <div style="margin-bottom: 1.25rem;">
              <label style="display: block; font-size: 0.875rem; font-weight: 500; color: #64748b; margin-bottom: 0.4rem;">
                Trạng thái bài viết
              </label>
              <select name="status" id="post-status" style="width: 100%; padding: 0.6rem; border-radius: 0.375rem; border: 1px solid #cbd5e1; font-size: 0.95rem; background: #fff;">
                <option value="published" selected={post.status === 'published'}>Đã xuất bản</option>
                <option value="draft" selected={post.status === 'draft'}>Bản nháp</option>
              </select>
            </div>

            <div style="display: flex; flex-direction: column; gap: 0.75rem;">
              <button type="submit" id="btn-submit" class="btn btn-primary" style="justify-content: center; width: 100%; padding: 0.75rem;">
                Lưu thay đổi
              </button>
              <a href={`/bai-viet/${post.slug}`} target="_blank" class="btn btn-secondary" style="justify-content: center; width: 100%; padding: 0.75rem; text-decoration: none;">
                Xem bài viết ngoài web
              </a>
            </div>
          </div>

          <div class="card">
            <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 1rem; color: #0f172a; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.5rem;">
              Ảnh đại diện (Cover)
            </h3>
            <input 
              type="url" 
              name="cover_image" 
              value={post.cover_image || ''}
              placeholder="Dán đường dẫn ảnh..." 
              style="width: 100%; padding: 0.65rem 0.85rem; border-radius: 0.375rem; border: 1px solid #cbd5e1; font-size: 0.9rem;"
            />
          </div>
        </div>
      </div>
    </form>
  )}

  <script>
    let quill: any;

    function initQuill() {
      // @ts-ignore
      if (typeof Quill !== 'undefined') {
        // @ts-ignore
        quill = new Quill('#quill-editor', {
          theme: 'snow',
          placeholder: 'Soạn thảo nội dung bài viết...',
          modules: {
            toolbar: [
              [{ header: [1, 2, 3, false] }],
              ['bold', 'italic', 'underline', 'strike'],
              [{ list: 'ordered' }, { list: 'bullet' }],
              ['blockquote', 'code-block'],
              [{ align: [] }],
              ['link', 'image'],
              ['clean']
            ]
          }
        });

        const rawContent = document.getElementById('raw-content');
        if (rawContent) {
          quill.root.innerHTML = rawContent.innerHTML;
        }
      } else {
        setTimeout(initQuill, 100);
      }
    }

    initQuill();

    const form = document.getElementById('edit-form') as HTMLFormElement;
    const btnSubmit = document.getElementById('btn-submit') as HTMLButtonElement;

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = form.getAttribute('data-id');

        if (!quill) {
          alert('Trình soạn thảo chưa sẵn sàng.');
          return;
        }

        const contentHTML = quill.root.innerHTML;
        (document.getElementById('post-content') as HTMLInputElement).value = contentHTML;

        btnSubmit.disabled = true;
        btnSubmit.innerText = 'Đang lưu thay đổi...';

        const formData = new FormData(form);

        try {
          const res = await fetch(`/api/posts/${id}`, {
            method: 'PUT',
            body: formData
          });

          const data = await res.json();
          if (res.ok && data.success) {
            alert('Cập nhật bài viết thành công!');
            window.location.href = '/admin';
          } else {
            alert(data.error || 'Có lỗi xảy ra khi cập nhật.');
            btnSubmit.disabled = false;
            btnSubmit.innerText = 'Lưu thay đổi';
          }
        } catch (err) {
          alert('Lỗi kết nối máy chủ.');
          btnSubmit.disabled = false;
          btnSubmit.innerText = 'Lưu thay đổi';
        }
      });
    }
  </script>
</AdminLayout>
