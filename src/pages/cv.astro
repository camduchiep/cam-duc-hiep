---
import Layout from '../layouts/Layout.astro';
import { getCVData } from '../lib/content';

export const prerender = false;

const db = Astro.locals.runtime?.env?.DB;
const cv = await getCVData(db);
---

<Layout title="CV" activeNav="cv">
  <div style="max-width: 800px; display: flex; flex-direction: column; gap: 40px; background: #ffffff;">
    <!-- Grant -->
    {cv.grants && cv.grants.length > 0 && (
      <section style="display: flex; flex-direction: column; gap: 8px;">
        <h2 style="font-size: 1.05rem; font-weight: 600; color: #000000; letter-spacing: -0.01em;">
          Grant
        </h2>
        <div style="display: flex; flex-direction: column; gap: 10px;">
          {cv.grants.map((grant) => (
            <div style="font-size: 0.95rem; color: #000000; opacity: 0.7; line-height: 1.6;">
              {grant.details ? (
                <>
                  {grant.title && grant.title !== 'Grant' && <span style="font-weight: 500; opacity: 1; color: #000;">{grant.title}: </span>}
                  {grant.details}
                </>
              ) : (
                grant.title
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Workshop -->
    {cv.workshops && cv.workshops.length > 0 && (
      <section style="display: flex; flex-direction: column; gap: 16px;">
        <h2 style="font-size: 1.05rem; font-weight: 600; color: #000000; letter-spacing: -0.01em;">
          Workshop
        </h2>
        <div style="display: flex; flex-direction: column; gap: 14px; font-size: 0.95rem; line-height: 1.6;">
          {cv.workshops.map((ws) => (
            <div>
              <div style="color: #000000; font-weight: 500;">{ws.title}</div>
              {ws.details && <div style="color: #000000; opacity: 0.7;">{ws.details}</div>}
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Education -->
    {cv.education && cv.education.length > 0 && (
      <section style="display: flex; flex-direction: column; gap: 8px;">
        <h2 style="font-size: 1.05rem; font-weight: 600; color: #000000; letter-spacing: -0.01em;">
          Education
        </h2>
        <div style="display: flex; flex-direction: column; gap: 12px; font-size: 0.95rem; line-height: 1.6;">
          {cv.education.map((edu) => (
            <div>
              <div style="color: #000000; font-weight: 500;">{edu.degree}</div>
              {edu.institution && <div style="color: #000000; opacity: 0.7;">{edu.institution}</div>}
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Selected screening -->
    {cv.screenings && cv.screenings.length > 0 && (
      <section style="display: flex; flex-direction: column; gap: 12px;">
        <h2 style="font-size: 1.05rem; font-weight: 600; color: #000000; letter-spacing: -0.01em;">
          Selected screening
        </h2>
        <ul style="list-style: none; padding-left: 0; display: flex; flex-direction: column; gap: 8px; font-size: 0.95rem; color: #000000; opacity: 0.7; line-height: 1.6;">
          {cv.screenings.map((sc) => (
            <li>{sc}</li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Layout>
