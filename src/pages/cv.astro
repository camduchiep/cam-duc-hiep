---
import Layout from '../layouts/Layout.astro';

export const prerender = false;
---

<Layout title="CV" activeNav="cv">
  <div style="max-width: 800px; display: flex; flex-direction: column; gap: 40px; background: #ffffff;">
    <!-- Grant -->
    <section style="display: flex; flex-direction: column; gap: 8px;">
      <h2 style="font-size: 1.05rem; font-weight: 600; color: #000000; letter-spacing: -0.01em;">
        Grant
      </h2>
      <div style="font-size: 0.95rem; color: #000000; opacity: 0.7; line-height: 1.6;">
        CJ Short Film Project, CJ Cultural Foundation & CJ CGV Vietnam, 2025
      </div>
    </section>

    <!-- Workshop -->
    <section style="display: flex; flex-direction: column; gap: 16px;">
      <h2 style="font-size: 1.05rem; font-weight: 600; color: #000000; letter-spacing: -0.01em;">
        Workshop
      </h2>
      <div style="display: flex; flex-direction: column; gap: 14px; font-size: 0.95rem; line-height: 1.6;">
        <div>
          <div style="color: #000000; font-weight: 500;">KAFA Training program</div>
          <div style="color: #000000; opacity: 0.7;">Korean Academy of Film Arts, HCMC, 2025</div>
        </div>
        <div>
          <div style="color: #000000; font-weight: 500;">Direct cinema workshop, Trần Phương Thảo & Swann Dubus</div>
          <div style="color: #000000; opacity: 0.7;">Varan Vietnam, Hanoi, 2024</div>
        </div>
      </div>
    </section>

    <!-- Education -->
    <section style="display: flex; flex-direction: column; gap: 8px;">
      <h2 style="font-size: 1.05rem; font-weight: 600; color: #000000; letter-spacing: -0.01em;">
        Education
      </h2>
      <div style="font-size: 0.95rem; color: #000000; opacity: 0.7; line-height: 1.6;">
        <div style="color: #000000; font-weight: 500;">Bachelor of Art in Film Directing</div>
        <div style="color: #000000; opacity: 0.7;">Hanoi Academy of Theater and Cinema</div>
      </div>
    </section>

    <!-- Selected screening -->
    <section style="display: flex; flex-direction: column; gap: 12px;">
      <h2 style="font-size: 1.05rem; font-weight: 600; color: #000000; letter-spacing: -0.01em;">
        Selected screening
      </h2>
      <ul style="list-style: none; padding-left: 0; display: flex; flex-direction: column; gap: 8px; font-size: 0.95rem; color: #000000; opacity: 0.7; line-height: 1.6;">
        <li>Atelier Varan, Paris, 2026</li>
        <li>Queer Museum, Hanoi, 2025</li>
        <li>Konima Cinema, KONIMA 11, HCMC, 2025</li>
      </ul>
    </section>
  </div>
</Layout>
