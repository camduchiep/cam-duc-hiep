---
import Layout from '../../layouts/Layout.astro';
import { getFilmBySlug, getFilms } from '../../lib/films';
import { films as defaultFilms } from '../../data/films';

export const prerender = false;

const { slug } = Astro.params;
const db = Astro.locals.runtime?.env?.DB;

let film = await getFilmBySlug(slug || '', db);
if (!film) {
  film = defaultFilms.find((f) => f.slug === slug);
}

if (!film) {
  return Astro.redirect('/404');
}
---

<Layout title={film.title} activeSlug={film.slug}>
  <div class="film-container" style="display: flex; align-items: flex-start; gap: clamp(60px, 6vw, 100px); width: 100%;">
    <!-- Main Column: Title, Format, Canvas Content -->
    <div class="film-content-col" style="max-width: 840px; width: 100%; display: flex; flex-direction: column;">
      <!-- Title -->
      <h1 style="font-family: var(--font-serif); font-size: 1.85rem; font-weight: 400; color: #000000; letter-spacing: -0.01em; line-height: 1.25; margin-bottom: 8px;">
        {film.title}
      </h1>

      <!-- Format / Metadata -->
      {film.format && (
        <p style="font-size: 0.92rem; color: #000000; margin-bottom: 28px;">
          {film.format}
        </p>
      )}

      <!-- Canvas Content (Dynamic Rich HTML from CMS) -->
      {film.content_html ? (
        <div class="film-canvas-content" set:html={film.content_html} />
      ) : (
        <>
          <!-- Legacy Fallback: Synopsis -->
          {film.synopsis && (
            <p style="font-size: 0.95rem; color: #000000; line-height: 1.6; margin-bottom: 32px; white-space: pre-line;">
              {film.synopsis}
            </p>
          )}

          <!-- Legacy Fallback: Stills Gallery -->
          {film.stills && film.stills.length > 0 && (
            <div style="display: flex; flex-direction: column; gap: 4px; width: 100%;">
              {film.stills.map((still: string, idx: number) => (
                <img 
                  src={still} 
                  alt={`${film.title} still ${idx + 1}`} 
                  loading={idx === 0 ? "eager" : "lazy"}
                  style="width: 100%; height: auto; display: block; margin-bottom: 2px;"
                />
              ))}
            </div>
          )}
        </>
      )}
    </div>

    <!-- Right Column: Production Credits -->
    {film.credits && film.credits.length > 0 && (
      <aside class="film-credits" style="width: 260px; flex-shrink: 0; padding-top: 4px; display: flex; flex-direction: column; gap: 20px;">
        {film.credits.map((credit: any) => (
          <div style="display: flex; flex-direction: column; gap: 1px;">
            <div style="font-size: 0.88rem; color: #666666; font-weight: 400;">
              {credit.role}
            </div>
            <div style="font-size: 0.92rem; color: #000000; font-weight: 400;">
              {Array.isArray(credit.names) ? credit.names.join(', ') : (credit.name || credit.names || '')}
            </div>
          </div>
        ))}
      </aside>
    )}
  </div>
</Layout>

<style is:global>
  .film-canvas-content {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #000000;
  }
  .film-canvas-content p {
    margin-bottom: 1.5rem;
  }
  .film-canvas-content img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 8px 0;
  }
</style>
