---
import Layout from '../../layouts/Layout.astro';
import { films } from '../../data/films';

export const prerender = false;

const { slug } = Astro.params;
const film = films.find((f) => f.slug === slug);

if (!film) {
  return Astro.redirect('/404');
}
---

<Layout title={film.title} activeSlug={film.slug}>
  <div class="film-container">
    <!-- Main Column: Title, Format, Synopsis, Stills -->
    <div class="film-content-col">
      <!-- Title -->
      <h1 class="film-title">
        {film.displayTitle}
      </h1>

      <!-- Format / Metadata -->
      <p class="film-format">
        {film.format}
      </p>

      <!-- Synopsis -->
      {film.synopsis && (
        <p class="film-synopsis">
          {film.synopsis}
        </p>
      )}

      <!-- Stills Gallery (Stacked seamlessly matching screenshot) -->
      {film.stills && film.stills.length > 0 && (
        <div class="film-stills">
          {film.stills.map((still, idx) => (
            <img 
              src={still} 
              alt={`${film.title} still ${idx + 1}`} 
              loading={idx === 0 ? "eager" : "lazy"}
              class="film-still-img"
            />
          ))}
        </div>
      )}
    </div>

    <!-- Right Column: Production Credits (Đoàn làm phim) -->
    {film.credits && film.credits.length > 0 && (
      <aside class="film-credits-col">
        {film.credits.map((credit) => (
          <div class="credit-item">
            <div class="credit-role">
              {credit.role}
            </div>
            {credit.names.map((name) => (
              <div class="credit-name">
                {name}
              </div>
            ))}
          </div>
        ))}
      </aside>
    )}
  </div>

  <style>
    .film-container {
      display: flex;
      align-items: flex-start;
      gap: 60px;
      width: 100%;
      background-color: #ffffff;
    }

    .film-content-col {
      max-width: 650px;
      width: 100%;
      flex: 1 1 auto;
      display: flex;
      flex-direction: column;
    }

    .film-title {
      font-family: var(--font-serif);
      font-size: 1.85rem;
      font-weight: 400;
      color: #000000;
      letter-spacing: -0.01em;
      line-height: 1.25;
      margin-bottom: 8px;
    }

    .film-format {
      font-size: 0.92rem;
      color: #000000;
      margin-bottom: 24px;
      font-weight: 400;
    }

    .film-synopsis {
      font-size: 0.95rem;
      color: #000000;
      line-height: 1.55;
      margin-bottom: 32px;
      white-space: pre-line;
      font-weight: 400;
    }

    .film-stills {
      display: flex;
      flex-direction: column;
      gap: 0px;
      width: 100%;
    }

    .film-still-img {
      width: 100%;
      height: auto;
      display: block;
    }

    .film-credits-col {
      width: 250px;
      flex-shrink: 0;
      padding-top: 4px;
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .credit-item {
      display: flex;
      flex-direction: column;
      gap: 1px;
    }

    .credit-role {
      font-size: 0.88rem;
      color: #666666;
      font-weight: 400;
    }

    .credit-name {
      font-size: 0.92rem;
      color: #000000;
      font-weight: 400;
    }

    @media (max-width: 820px) {
      .film-container {
        flex-direction: column !important;
        gap: 36px !important;
      }
      .film-credits-col {
        width: 100% !important;
        border-top: 1px solid #f0f0f0;
        padding-top: 24px;
      }
    }
  </style>
</Layout>
