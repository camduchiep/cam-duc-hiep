---
import Layout from '../../layouts/Layout.astro';
import { getFilmBySlug, getFilms } from '../../lib/films';
import { films as defaultFilms } from '../../data/films';

export const prerender = false;

const { slug } = Astro.params;
const db = Astro.locals.runtime?.env?.DB;

let film = await getFilmBySlug(slug || '', db);
if (!film) {
  film = defaultFilms.find((f) => f.slug === slug);
}

if (!film) {
  return Astro.redirect('/404');
}
---

<Layout title={film.title} activeSlug={film.slug}>
  <div class="film-container" style="display: flex; align-items: flex-start; gap: clamp(60px, 6vw, 100px); width: 100%;">
    <!-- Main Column: Title, Format, Canvas Content -->
    <div class="film-content-col" style="max-width: 840px; width: 100%; display: flex; flex-direction: column;">
      <!-- Title: Font Fraunces, Cỡ chữ 25px, Màu #313030 -->
      <h1 style="font-family: var(--font-serif); font-size: 25px; font-weight: 400; color: #313030; letter-spacing: -0.01em; line-height: 1.25; margin-bottom: 8px;">
        {film.title}
      </h1>

      <!-- Format / Thông số: Font Inter, Cỡ chữ 16px, Màu #545454 -->
      {film.format && (
        <p style="font-family: var(--font-sans); font-size: 16px; color: #545454; margin-bottom: 28px; line-height: 1.5;">
          {film.format}
        </p>
      )}

      <!-- Canvas Content: Font Inter, Cỡ chữ 15px, Màu #313030 -->
      {film.content_html ? (
        <div class="film-canvas-content" set:html={film.content_html} />
      ) : (
        <>
          <!-- Legacy Fallback: Synopsis -->
          {film.synopsis && (
            <p style="font-family: var(--font-sans); font-size: 15px; color: #313030; line-height: 1.4; margin-bottom: 32px; white-space: pre-line;">
              {film.synopsis}
            </p>
          )}

          <!-- Legacy Fallback: Stills Gallery -->
          {film.stills && film.stills.length > 0 && (
            <div style="display: flex; flex-direction: column; gap: 4px; width: 100%;">
              {film.stills.map((still: string, idx: number) => (
                <img 
                  src={still} 
                  alt={`${film.title} still ${idx + 1}`} 
                  loading={idx === 0 ? "eager" : "lazy"}
                  style="width: 100%; height: auto; display: block; margin-bottom: 2px;"
                />
              ))}
            </div>
          )}
        </>
      )}
    </div>

    <!-- Right Column: Production Credits: Font Inter, Cỡ chữ 13px -->
    {film.credits && film.credits.length > 0 && (
      <aside class="film-credits" style="width: 260px; flex-shrink: 0; padding-top: 4px; display: flex; flex-direction: column; gap: 20px; font-family: var(--font-sans);">
        {film.credits.map((credit: any) => (
          <div style="display: flex; flex-direction: column; gap: 2px;">
            <div style="font-size: 13px; color: #545454; font-weight: 400; line-height: 1.4;">
              {credit.role}
            </div>
            <div style="font-size: 13px; color: #313030; font-weight: 400; line-height: 1.4;">
              {Array.isArray(credit.names) ? credit.names.join(', ') : (credit.name || credit.names || '')}
            </div>
          </div>
        ))}
      </aside>
    )}
  </div>
</Layout>

<script is:inline>
  // Ensure simulated gif / loop videos autoplay reliably
  document.addEventListener('DOMContentLoaded', () => {
    const loopVideos = document.querySelectorAll('.film-canvas-content video');
    loopVideos.forEach(v => {
      if (v.hasAttribute('loop') || v.getAttribute('data-loop') === 'true') {
        v.muted = true;
        v.play().catch(() => {});
      }
    });
  });
</script>

<style is:global>
  .film-canvas-content {
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.4;
    color: #313030;
  }
  .film-canvas-content p {
    font-size: 15px;
    line-height: 1.4;
    color: #313030;
    margin-bottom: 1.5rem;
  }
  .film-canvas-content img {
    max-width: 100%;
    height: auto;
    display: inline-block;
    margin: 8px 0;
  }
  .film-canvas-content video {
    max-width: 100%;
    height: auto;
    display: inline-block;
    margin: 8px 0;
    border-radius: 2px;
  }
  .film-canvas-content video[data-loop="true"],
  .film-canvas-content video[loop]:not([controls]) {
    pointer-events: none;
  }
  .film-canvas-content .canvas-img-wrapper {
    margin: 16px 0;
    text-align: center;
  }
</style>
