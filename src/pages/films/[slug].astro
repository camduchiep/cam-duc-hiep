---
import Layout from '../../layouts/Layout.astro';
import { films } from '../../data/films';

export const prerender = false;

const { slug } = Astro.params;
const film = films.find((f) => f.slug === slug);

if (!film) {
  return Astro.redirect('/404');
}
---

<Layout title={film.title} activeSlug={film.slug}>
  <div class="film-container" style="display: flex; align-items: flex-start; gap: 75px; width: 100%;">
    <!-- Main Column: Title, Format, Synopsis, Stills -->
    <div style="max-width: 650px; width: 100%; display: flex; flex-direction: column;">
      <!-- Title -->
      <h1 style="font-family: var(--font-serif); font-size: 1.85rem; font-weight: 400; color: #000000; letter-spacing: -0.01em; line-height: 1.25; margin-bottom: 8px;">
        {film.displayTitle}
      </h1>

      <!-- Format / Metadata -->
      <p style="font-size: 0.92rem; color: #000000; margin-bottom: 24px;">
        {film.format}
      </p>

      <!-- Synopsis -->
      {film.synopsis && (
        <p style="font-size: 0.95rem; color: #000000; line-height: 1.55; margin-bottom: 32px; white-space: pre-line;">
          {film.synopsis}
        </p>
      )}

      <!-- Stills Gallery (Stacked directly below synopsis, minimal gap) -->
      {film.stills && film.stills.length > 0 && (
        <div style="display: flex; flex-direction: column; gap: 2px; width: 100%;">
          {film.stills.map((still, idx) => (
            <img 
              src={still} 
              alt={`${film.title} still ${idx + 1}`} 
              loading={idx === 0 ? "eager" : "lazy"}
              style="width: 100%; height: auto; display: block;"
            />
          ))}
        </div>
      )}
    </div>

    <!-- Right Column: Production Credits (Đoàn làm phim) -->
    {film.credits && film.credits.length > 0 && (
      <aside class="film-credits" style="width: 260px; flex-shrink: 0; padding-top: 4px; display: flex; flex-direction: column; gap: 20px;">
        {film.credits.map((credit) => (
          <div style="display: flex; flex-direction: column; gap: 1px;">
            <div style="font-size: 0.88rem; color: #666666; font-weight: 400;">
              {credit.role}
            </div>
            {credit.names.map((name) => (
              <div style="font-size: 0.92rem; color: #000000; font-weight: 400;">
                {name}
              </div>
            ))}
          </div>
        ))}
      </aside>
    )}
  </div>
</Layout>
