---
import Layout from '../layouts/Layout.astro';
import { films } from '../data/films';

export const prerender = false;

// Group films matching the 2-row layout from Page 1 of the reference
const topRowFilms = films.slice(0, 2);    // A tale of King Kong, Utopia
const bottomRowFilms = films.slice(2, 5); // Lover for rent, Thành phố muối, Thư - thư
---

<Layout title="Films">
  <div style="display: flex; flex-direction: column; gap: 50px; width: 100%;">
    <!-- Top Row: 2 large cards -->
    <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px;">
      {topRowFilms.map((film) => (
        <a 
          href={`/films/${film.slug}`} 
          style="display: flex; flex-direction: column; text-decoration: none; group; transition: opacity 0.25s;"
          class="film-card"
        >
          <div style="width: 100%; aspect-ratio: 16/10; overflow: hidden; background: #111111; margin-bottom: 14px;">
            <img 
              src={film.thumbnail} 
              alt={film.title} 
              loading="eager"
              style="width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s ease, opacity 0.3s ease;"
              class="film-thumb"
            />
          </div>
          <div style="display: flex; flex-direction: column; gap: 2px;">
            <h2 style="font-size: 1.05rem; font-weight: 500; color: #ffffff; letter-spacing: -0.01em;">
              {film.title.charAt(0).toUpperCase() + film.title.slice(1)}
            </h2>
            <p style="font-size: 0.88rem; color: #888888; font-weight: 400;">
              {film.category} | {film.year}
            </p>
          </div>
        </a>
      ))}
    </div>

    <!-- Bottom Row: 3 cards -->
    <div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px;">
      {bottomRowFilms.map((film) => (
        <a 
          href={`/films/${film.slug}`} 
          style="display: flex; flex-direction: column; text-decoration: none; transition: opacity 0.25s;"
          class="film-card"
        >
          <div style="width: 100%; aspect-ratio: 16/9.5; overflow: hidden; background: #111111; margin-bottom: 14px;">
            <img 
              src={film.thumbnail} 
              alt={film.title} 
              loading="lazy"
              style="width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s ease, opacity 0.3s ease;"
              class="film-thumb"
            />
          </div>
          <div style="display: flex; flex-direction: column; gap: 2px;">
            <h2 style="font-size: 1.02rem; font-weight: 500; color: #ffffff; letter-spacing: -0.01em;">
              {film.title.charAt(0).toUpperCase() + film.title.slice(1)}
            </h2>
            <p style="font-size: 0.86rem; color: #888888; font-weight: 400;">
              {film.category} | {film.year}
            </p>
          </div>
        </a>
      ))}
    </div>
  </div>

  <style>
    .film-card:hover .film-thumb {
      transform: scale(1.02);
      opacity: 0.9;
    }
    @media (max-width: 900px) {
      div[style*="grid-template-columns: repeat(2"] {
        grid-template-columns: 1fr !important;
      }
      div[style*="grid-template-columns: repeat(3"] {
        grid-template-columns: 1fr !important;
      }
    }
  </style>
</Layout>
