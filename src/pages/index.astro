---
import Layout from '../layouts/Layout.astro';
import { getFilms } from '../lib/films';
import { films as defaultFilms } from '../data/films';

export const prerender = false;

const db = Astro.locals.runtime?.env?.DB;
const dbFilms = await getFilms(db);
const films = dbFilms && dbFilms.length > 0 ? dbFilms : defaultFilms;

// Grouping logic theo thiết kế ref:
// - Tối đa 3 phim mỗi hàng.
// - Nếu tổng số phim chia 3 dư 2 (như 5 phim hiện tại):
//   Hàng 1 có 2 phim (tự động căn giữa), các hàng tiếp theo có 3 phim (hoặc căn giữa nếu còn 1-2 phim).
// - Nếu tổng số phim chia 3 dư 0 (như 6 phim, 3 phim):
//   Mỗi hàng có 3 phim.
// - Nếu tổng số phim chia 3 dư 1 (như 4 phim, 7 phim):
//   Hàng đầu hoặc hàng cuối căn giữa tự động.
function groupFilmsIntoRows(list: typeof films) {
  const total = list.length;
  if (total === 0) return [];
  if (total <= 3) return [list];

  const rows = [];
  let start = 0;
  if (total % 3 === 2) {
    // 5 phim: Hàng đầu có 2 phim căn giữa như ảnh ref
    rows.push(list.slice(0, 2));
    start = 2;
  } else if (total % 3 === 1 && total === 4) {
    // 4 phim: 2 phim hàng trên, 2 phim hàng dưới căn giữa
    rows.push(list.slice(0, 2));
    start = 2;
  }

  while (start < total) {
    rows.push(list.slice(start, start + 3));
    start += 3;
  }
  return rows;
}

const filmRows = groupFilmsIntoRows(films);
---

<Layout title="Films">
  <div style="display: flex; flex-direction: column; gap: 48px; width: 100%; background: #ffffff;">
    {filmRows.map((row) => (
      <div 
        class="film-row" 
        style="display: flex; justify-content: center; gap: 32px; width: 100%; box-sizing: border-box;"
      >
        {row.map((film) => {
          const displayTitle = film.listTitle || film.title.split('|')[0].trim();
          const displaySubtitle = film.listSubtitle || film.format || '';

          return (
            <a 
              href={`/films/${film.slug}`} 
              class="film-card"
              style="flex: 0 0 calc((100% - 64px) / 3) !important; width: calc((100% - 64px) / 3) !important; max-width: calc((100% - 64px) / 3) !important; min-width: 0 !important; box-sizing: border-box !important; display: flex; flex-direction: column; text-decoration: none !important; transition: opacity 0.25s; background: #ffffff;"
            >
              <!-- Thumbnail Frame: Chiều cao và tỉ lệ đồng nhất tuyệt đối trên mọi hàng -->
              <div 
                class="thumb-frame" 
                style="width: 100% !important; aspect-ratio: 16 / 10 !important; overflow: hidden !important; background: #f8fafc; margin-bottom: 12px; border-radius: 2px; position: relative; box-sizing: border-box !important; min-width: 0 !important;"
              >
                {film.thumbnail ? (
                  <img 
                    src={film.thumbnail} 
                    alt={displayTitle} 
                    loading="lazy"
                    style="width: 100% !important; height: 100% !important; max-width: 100% !important; max-height: 100% !important; object-fit: cover !important; object-position: center !important; display: block !important; transition: transform 0.4s ease, opacity 0.3s ease;"
                    class="film-thumb"
                  />
                ) : (
                  <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 2px; color: #94a3b8; font-size: 0.82rem; box-sizing: border-box;">
                    <span>Chưa có poster</span>
                  </div>
                )}
              </div>

              <!-- Metadata Text: Font Inter cỡ chữ 15.5px -->
              <div style="display: flex; flex-direction: column; gap: 3px; min-width: 0;">
                <h2 style="font-family: var(--font-sans); font-size: 15.5px; font-weight: 500; color: #313030; letter-spacing: -0.01em; margin: 0; line-height: 1.35;">
                  {displayTitle}
                </h2>
                {displaySubtitle && (
                  <p style="font-family: var(--font-sans); font-size: 15.5px; color: #545454; font-weight: 400; margin: 0; line-height: 1.35;">
                    {displaySubtitle}
                  </p>
                )}
              </div>
            </a>
          );
        })}
      </div>
    ))}
  </div>

  <style is:global>
    /* Bố cục hàng phim: Tự động căn giữa nếu hàng chỉ có 1 hoặc 2 phim */
    .film-row {
      display: flex !important;
      justify-content: center !important;
      gap: 32px !important;
      width: 100% !important;
      box-sizing: border-box !important;
    }

    /* Mỗi card phim luôn cố định bằng 1/3 chiều rộng hàng trừ đi khoảng cách gap (32px * 2) */
    .film-card {
      flex: 0 0 calc((100% - 64px) / 3) !important;
      width: calc((100% - 64px) / 3) !important;
      max-width: calc((100% - 64px) / 3) !important;
      min-width: 0 !important;
      box-sizing: border-box !important;
    }

    /* Khung thumbnail: Đảm bảo chiều cao ngang nhau 100%, không bị vỡ ảnh hay phình to */
    .thumb-frame {
      width: 100% !important;
      aspect-ratio: 16 / 10 !important;
      overflow: hidden !important;
      position: relative !important;
      box-sizing: border-box !important;
      min-width: 0 !important;
    }

    .film-thumb {
      width: 100% !important;
      height: 100% !important;
      max-width: 100% !important;
      max-height: 100% !important;
      object-fit: cover !important;
      object-position: center !important;
      display: block !important;
    }

    .film-card:hover .film-thumb {
      transform: scale(1.02);
      opacity: 0.92;
    }

    @media (max-width: 900px) {
      .film-row {
        flex-direction: column !important;
        align-items: center !important;
        gap: 36px !important;
      }
      .film-card {
        flex: 0 0 100% !important;
        width: 100% !important;
        max-width: 100% !important;
      }
    }
  </style>
</Layout>
